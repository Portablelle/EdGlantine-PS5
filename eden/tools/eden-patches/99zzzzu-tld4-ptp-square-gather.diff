+    /// Puts a 2x2 square's gather back in the PTP offsets' order (no-op otherwise).
+    Id GatherSquareResult(EmitContext& ctx, Id result_type, Id color) const {
+        if (!square) {
+            return color;
+        }
+        return ctx.OpVectorShuffle(result_type, color, color, square_swizzle[0],
+                                   square_swizzle[1], square_swizzle[2], square_swizzle[3]);
+    }
+
 private:
+    /// A gather's component for the texel at (dx, dy) from its (i0, j0) texel, indexed by
+    /// dx + 2 * dy: x = (i0, j1), y = (i1, j1), z = (i1, j0), w = (i0, j0).
+    static constexpr std::array<u32, 4> GATHER_SQUARE_COMPONENT{3, 2, 0, 1};
+
+    static bool CanGatherSquare(IR::Inst* inst) {
+        if (inst->GetAssociatedPseudoOperation(IR::Opcode::GetSparseFromOp)) {
+            return false;
+        }
+        const auto type{inst->Flags<IR::TextureInstInfo>().type.Value()};
+        return type == TextureType::Color2D || type == TextureType::ColorArray2D;
+    }
+
+    /// Whether the PTP offsets are (c, c+(1,0), c+(0,1), c+(1,1)) in any order, with c the
+    /// smallest x and y; records c and each offset's component of the gather at c.
+    bool FindGatherSquare(const std::array<s32, 8>& ptp) {
+        const s32 x{std::min({ptp[0], ptp[2], ptp[4], ptp[6]})};
+        const s32 y{std::min({ptp[1], ptp[3], ptp[5], ptp[7]})};
+        u32 seen{};
+        std::array<u32, 4> swizzle{};
+        for (size_t i = 0; i < 4; ++i) {
+            const s32 dx{ptp[2 * i] - x};
+            const s32 dy{ptp[2 * i + 1] - y};
+            if (dx < 0 || dx > 1 || dy < 0 || dy > 1) {
+                return false;
+            }
+            const u32 cell{static_cast<u32>(dx + 2 * dy)};
+            if ((seen & (1U << cell)) != 0) {
+                return false;
+            }
+            seen |= 1U << cell;
+            swizzle[i] = GATHER_SQUARE_COMPONENT[cell];
+        }
+        square = true;
+        square_x = x;
+        square_y = y;
+        square_swizzle = swizzle;
+        return true;
+    }
