+template <class P>
+bool TextureCache<P>::UploadConvertedInChunks(Image& image) {
+    // A converted image (ASTC kept as BC1/BC3) was staged whole: a 1434x1434 array of 46 layers
+    // asked for 121 MiB in one block and the console refused it, with blocks of 80 MiB free
+    // (issue #20). ConvertImage treats layers independently, so groups of layers of at most
+    // 32 MiB are converted into their own staging buffer and uploaded in turn: same bytes.
+    constexpr u64 chunk_size = 32_MiB;
+    constexpr ImageFlagBits excluded = ImageFlagBits::Sparse | ImageFlagBits::AcceleratedUpload |
+                                       ImageFlagBits::Unbacked | ImageFlagBits::TrimmedLevels;
+    const u32 layers = static_cast<u32>(image.info.resources.layers);
+    const u64 total = MapSizeBytes(image);
+    if (False(image.flags & ImageFlagBits::Converted) || True(image.flags & excluded) ||
+        image.info.type != ImageType::e2D || layers < 2 || total <= chunk_size || total % layers != 0) {
+        return false;
+    }
+    unswizzle_data_buffer.resize_destructive(image.unswizzled_size_bytes);
+    const auto copies = FixSmallVectorADL(UnswizzleImage(*gpu_memory, image.gpu_addr, image.info, {},
+                                                         unswizzle_data_buffer, &swizzle_data_buffer));
+    const u64 layer_size = total / layers;
+    const u32 group = static_cast<u32>((std::max<u64>)(1, chunk_size / layer_size));
+    for (u32 first = 0; first < layers; first += group) {
+        const u32 count = (std::min)(group, layers - first);
+        auto group_copies = copies;
+        for (auto& copy : group_copies) {
+            const size_t input_layer = copy.buffer_size / layers;
+            copy.buffer_offset += first * input_layer;
+            copy.buffer_size = count * input_layer;
+            copy.image_subresource.num_layers = static_cast<s32>(count);
+        }
+        auto staging = runtime.UploadStagingBuffer(layer_size * count);
+        ConvertImage(unswizzle_data_buffer, image.info, staging.mapped_span, group_copies);
+        for (auto& copy : group_copies) {
+            copy.image_subresource.base_layer = static_cast<s32>(first);
+        }
+        image.UploadMemory(staging, group_copies);
+    }
+    runtime.InsertUploadMemoryBarrier();
+    return true;
+}
