+struct DroppedReadbacks {
+    size_t images = 0;
+    size_t bytes = 0;
+};
+
+// Takes the image readbacks out of a batch whose staging buffer graphics memory refused even
+// after the pool's retries (issue #20: a 144 MiB readback of a 6144x6144 render target ended a
+// session with 462 MiB free in blocks of 128 MiB at most). They are the preemptive copies of
+// render targets the CPU read before. The image stays GPU-modified and forced_flushed goes back
+// to false, so the CPU's next read of it flushes it for real instead of trusting guest memory.
+// Buffer readbacks stay. Returns what was not read back.
+template <class Image, class Downloads>
+DroppedReadbacks DropImageReadbacks(Downloads& downloads, Common::SlotVector<Image>& images) {
+    DroppedReadbacks dropped;
+    const auto end = std::remove_if(downloads.begin(), downloads.end(), [&](const auto& download) {
+        if (!download.is_swizzle) {
+            return false;
+        }
+        auto& image = download.GetImage(images);
+        image.info.forced_flushed = false;
+        ++dropped.images;
+        dropped.bytes += image.unswizzled_size_bytes;
+        return true;
+    });
+    downloads.erase(end, downloads.end());
+    return dropped;
+}
+
+// EDEN_READBACK_SKIPPED in stderr: the 1st, 2nd, 4th, 8th ... skip.
+inline void ReportDroppedReadbacks(const char* kind, const DroppedReadbacks& dropped) {
+    static std::atomic<unsigned long long> skips{0};
+    const auto times = skips.fetch_add(1, std::memory_order_relaxed) + 1;
+    if ((times & (times - 1)) == 0) {
+        std::fprintf(stderr, "EDEN_READBACK_SKIPPED kind=%s images=%zu bytes=%zu: graphics memory refused "
+                     "the staging buffer (%llu so far)\n", kind, dropped.images, dropped.bytes, times);
+    }
+}
+
 } // namespace VideoCommon
