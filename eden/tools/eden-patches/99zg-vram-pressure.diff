+template <class P>
+size_t TextureCache<P>::ReclaimMemory() {
+    // Called when graphics memory is refused (vk_staging_buffer_pool.cpp), from inside texture
+    // cache work: JoinImages holds the ids of the images it merges and PrepareImage touches an
+    // image only after uploading it, so evicting images here could delete one still in use. The
+    // images already deleted wait TICKS_TO_DESTROY frames for the GPU in sentenced_images; once
+    // the GPU is idle they can go now. The next frame's collector evicts in aggressive mode.
+    if (reclaiming) {
+        return 0; // Finish() asked for memory again
+    }
+    reclaiming = true;
+    SCOPE_EXIT {
+        reclaiming = false;
+    };
+    reclaim_requested = true;
+    runtime.Finish();
+    return sentenced_images.Clear();
+}
