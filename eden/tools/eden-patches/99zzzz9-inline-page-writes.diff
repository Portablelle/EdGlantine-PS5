+template <class P>
+void BufferCache<P>::WriteMemoryAfterWrite(DAddr device_addr, u64 size) {
+    // Only the GPU command path in WriteBlockImpl may inline, after copying the guest bytes.
+    constexpr u64 address_space = u64{1} << 36;
+    if (size != 0 && size <= DEVICE_PAGESIZE && device_addr != 0 &&
+        device_addr < address_space && size <= address_space - device_addr) {
+        const BufferId buffer_id = page_table[device_addr >> CACHING_PAGEBITS];
+        const DAddr page_begin = Common::AlignDown(device_addr, DEVICE_PAGESIZE);
+        const DAddr page_end = Common::AlignUp(device_addr + size, DEVICE_PAGESIZE);
+        // An overlap is insufficient: FindBuffer must reuse this buffer, never create or merge.
+        if (buffer_id && slot_buffers[buffer_id].IsInBounds(device_addr, size) &&
+            IsRegionGpuModified(page_begin, page_end - page_begin)) {
+            tmp_buffer.resize_destructive(size);
+            device_memory.ReadBlockUnsafe(device_addr, tmp_buffer.data(), size);
+            InlineMemoryImplementation(device_addr, size, tmp_buffer);
+            return;
+        }
+    }
+    WriteMemory(device_addr, size);
 }

