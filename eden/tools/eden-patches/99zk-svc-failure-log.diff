+// A kernel result other than success in the first return register, logged with the call's inputs:
+// a game that stops on a kernel error shows which call returned it. Calls that return no result
+// can leave a value there; a value equal to the first input, and the expected timeouts and
+// cancellations of waits, are skipped. At most 512 lines, InvalidEnumValue (2001-0120) always.
+void LogSvcFailure(Core::System& system, u32 imm, const std::array<uint64_t, 8>& in,
+                   const std::array<uint64_t, 8>& out) {
+    const u32 raw = static_cast<u32>(out[0]);
+    if (raw == 0 || (raw & 0x1FF) != 1 || static_cast<u32>(in[0]) == raw) {
+        return;
+    }
+    const u32 description = (raw >> 9) & 0x1FFF;
+    if (description == 117 || description == 118) { // TimedOut, Cancelled
+        return;
+    }
+    static std::atomic<u32> logged{0};
+    const bool always = description == 120;
+    if (!always && logged.fetch_add(1, std::memory_order_relaxed) >= 512) {
+        return;
+    }
+    LOG_WARNING(Kernel_SVC,
+                "EDEN_SVC_FAIL svc={:#x} result={:#x} (2001-{:04}) thread={} "
+                "in=[{:#x} {:#x} {:#x} {:#x} {:#x} {:#x}] out1={:#x}",
+                imm, raw, description, GetCurrentThread(system.Kernel()).GetThreadId(), in[0],
+                in[1], in[2], in[3], in[4], in[5], out[1]);
+}
