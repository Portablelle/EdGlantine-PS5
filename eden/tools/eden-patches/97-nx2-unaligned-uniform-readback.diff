+        // Alignment alone may force streaming even when this range is GPU-written.
+        // Finish the exact readback before allocating the mapped upload: a download
+        // can submit/wait and retire staging allocations.
+        if (needs_alignment_stream && memory_tracker.IsRegionGpuModified(device_addr, size)) {
+            SynchronizeBuffer(buffer, device_addr, size);
+            DownloadBufferMemory(buffer, device_addr, size);
+        #ifdef EDEN_NX2_PS5_PROTO
+            static std::atomic<unsigned long long> alignment_syncs{0};
+            const auto count = alignment_syncs.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (count <= 4 || (count & (count - 1)) == 0)
+                std::fprintf(stderr, "NX2_UNIFORM_ALIGN_SYNC stage=graphics address=%llx bytes=%u checks=%llu\n",
+                             static_cast<unsigned long long>(device_addr), size, count);
+        #endif
+        }
         // Stream buffer path to avoid stalling on non-Nvidia drivers or Vulkan
         const std::span<u8> span = runtime.BindMappedUniformBuffer(stage, binding_index, size);
         device_memory.ReadBlockUnsafe(device_addr, span.data(), size);
