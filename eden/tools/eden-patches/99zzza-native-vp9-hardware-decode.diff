+    // Size and profile from the uncompressed header of a VP9 keyframe (VP9 spec 6.2), read from
+    // the first frame of the packet as the hardware session's keyframe test does. Anything
+    // else (inter, intra-only, show-existing or a malformed header) returns nothing.
+    static std::optional<FFmpeg::FrameDimensions> Vp9KeyframeSize(std::span<const u8> packet) {
+        Eden::VideoDecode::Bits bits{packet};
+        if (bits.Read(2) != 2) return std::nullopt; // frame_marker
+        s32 profile = static_cast<s32>(bits.Read(1));
+        profile |= static_cast<s32>(bits.Read(1)) << 1;
+        if (profile == 3) bits.Read(1); // reserved_zero
+        if (bits.Read(1)) return std::nullopt; // show_existing_frame
+        if (bits.Read(1)) return std::nullopt; // frame_type: 1 is a non-key frame
+        bits.Read(2); // show_frame, error_resilient_mode
+        if (bits.Read(24) != 0x498342) return std::nullopt; // frame_sync_code
+        if (profile >= 2) bits.Read(1); // ten_or_twelve_bit
+        const bool odd_profile = profile == 1 || profile == 3;
+        if (bits.Read(3) != 7) { // color_space other than sRGB
+            bits.Read(1); // color_range
+            if (odd_profile) bits.Read(3); // subsampling_x, subsampling_y, reserved_zero
+        } else if (odd_profile) {
+            bits.Read(1); // reserved_zero
+        }
+        const s32 width = static_cast<s32>(bits.Read(16)) + 1;
+        const s32 height = static_cast<s32>(bits.Read(16)) + 1;
+        if (!bits.valid) return std::nullopt;
+        return FFmpeg::FrameDimensions{width, height, profile};
+    }
+
+    // Native VP9 on the frontend's hardware decoder (libSceVideodec2 on PS5). Returns false when
+    // this packet must go to FFmpeg: the hardware refused the stream or failed and recovered
+    // at a keyframe, or no keyframe has opened it yet. Frames are synchronous and paired with
+    // their submission by pts, as in QueueH264Frame.
+    bool DecodeVp9OnHardware(const PendingInput& input) {
+        using Route = FFmpeg::HardwareVideoDecoderSession::Route;
+        using State = FFmpeg::HardwareVideoDecoderSession::State;
+        if (const auto keyframe = Vp9KeyframeSize(input.bytes)) {
+            // A new size needs a new decoder: reopen it at this keyframe.
+            if (h264_backend.IsActive() && *keyframe != vp9_dimensions) h264_backend.Reset();
+            vp9_dimensions = *keyframe;
+        } else if (h264_backend.GetState() == State::Selection) {
+            // The hardware only opens on a keyframe. Until then FFmpeg gets the packet, as
+            // before; it holds no delayed frames (no frame threading), so the switch is clean.
+            return false;
+        }
+        // Allows packets with only hidden frames (no output) on the hardware route.
+        h264_backend.AllowDelayedOutput();
+        const auto previous = h264_backend.GetState();
+        std::shared_ptr<FFmpeg::Frame> frame;
+        const auto route = h264_backend.Decode(Tegra::Host1x::NvdecCommon::VideoCodec::VP9,
+            input.bytes, {}, vp9_dimensions, static_cast<s64>(input.submission_id), {}, frame);
+        const auto state = h264_backend.GetState();
+        if (state != previous) {
+            LOG_INFO(Service_AM, "Native VP9 {}x{} profile {}: {}", vp9_dimensions.width,
+                     vp9_dimensions.height, vp9_dimensions.profile,
+                     state == State::Hardware   ? "hardware decoder" :
+                     state == State::Recovery   ? "hardware failed, waiting for a keyframe" :
+                     state == State::Fallback   ? "hardware failed, using FFmpeg" :
+                                                  "hardware refused, using FFmpeg");
+        }
+        if (route == Route::Software) return false;
+        if (route == Route::Hardware && frame) {
+            h264_timestamps[input.submission_id] = input.timestamp;
+            QueueH264Frame(frame, true);
+        }
+        // Skipped packets are consumed too: PumpOutput must keep progressing to a keyframe.
+        return true;
+    }
