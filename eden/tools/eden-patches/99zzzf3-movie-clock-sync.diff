+    // Lichii #251. OoT takes one movie frame per game frame, so below 60 FPS its movies fell
+    // behind their sound. For that title the decoder follows a real clock started at the first
+    // frame and skips frames that are more than two frame times late. A gap of over a second
+    // between takes (the game paused) moves the clock instead. EDEN_NX2_MOVIE_CLOCK_SYNC=0 turns
+    // this off, =1 turns it on for any title.
+    static constexpr u64 OcarinaOfTimeProgramId = 0x0400486024DEC000ULL;
+    static constexpr auto MovieClockPause = std::chrono::seconds{1};
+    using MovieClock = std::chrono::steady_clock;
+
+    bool SyncsToClock() const {
+        static const int forced = [] {
+            const char* value = std::getenv("EDEN_NX2_MOVIE_CLOCK_SYNC");
+            return value == nullptr ? -1 : (value[0] == '1' ? 1 : 0);
+        }();
+        if (forced >= 0) return forced == 1;
+        return system.GetApplicationProcessProgramID() == OcarinaOfTimeProgramId;
+    }
+
+    u64 MovieFrameMicroseconds() const {
+        const u32 rate = configuration ? configuration->frame_rate : 0;
+        return rate != 0 && rate <= 240 ? u64{1'000'000} / rate : u64{1'000'000} / 60;
+    }
+
+    bool IsLate(u64 timestamp) const {
+        // A stream whose timestamps do not move is never late.
+        if (!movie_clock_running || timestamp <= movie_clock_start_timestamp) return false;
+        const auto now = MovieClock::now();
+        if (now - movie_clock_last_take > MovieClockPause) return false;
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(now - movie_clock_start).count();
+        const u64 due = movie_clock_start_timestamp + static_cast<u64>((std::max<s64>)(elapsed, 0));
+        return timestamp + 2 * MovieFrameMicroseconds() < due;
+    }
+
+    void StartMovieClock(u64 timestamp) {
+        if (movie_clock_running || !SyncsToClock()) return;
+        movie_clock_running = true;
+        movie_clock_start = MovieClock::now();
+        movie_clock_last_take = movie_clock_start;
+        movie_clock_start_timestamp = timestamp;
+    }
+
+    void EndMovieClock() {
+        if (movie_late_dropped != 0) {
+            LOG_INFO(Service_AM, "native video skipped {} late frames to keep the movie in time",
+                     movie_late_dropped);
+        }
+        movie_late_dropped = 0;
+        movie_clock_running = false;
+    }
+
