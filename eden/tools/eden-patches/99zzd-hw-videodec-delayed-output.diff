+    std::vector<std::shared_ptr<Frame>> frames;
+    if (m_state != State::Hardware || !m_delayed) return frames;
+    if (!m_backend->DrainFrames(frames)) {
+        m_backend->ReportFallback("drain-failed");
+        Transition(State::Recovery);
+    }
+    std::erase_if(frames, [this](const std::shared_ptr<Frame>& frame) {
+        return !frame || !IsBackendFrameValid(*frame, m_dimensions, BackendFramePts(*frame));
+    });
+    return frames;
