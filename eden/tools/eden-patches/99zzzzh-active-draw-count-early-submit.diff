+    // Submit earlier on Ampere so the host GPU can work while native recording continues.
+    // 512 draws = 16 desktop dispatch intervals: 8x sooner than 4096, but 4x the batching
+    // of upstream's 128 to limit submission overhead. This is a tuning default, not a measured
+    // FPS gain. Keep the check cadence separate from this submission threshold.
+    static const u32 native_flush_draws = [] {
+        constexpr u32 fallback = 512;
+        static_assert(fallback % (CHECK_MASK + 1) == 0);
+        const char* value = std::getenv("EDEN_NX2_FLUSH_DRAWS");
+        if (value == nullptr || value[0] < '0' || value[0] > '9') {
+            return fallback;
+        }
+        char* end = nullptr;
+        const unsigned long parsed = std::strtoul(value, &end, 10);
+        if (*end != '\0' || parsed == 0) {
+            return fallback;
+        }
+        // Clamp to [32, 1048576] draws; nonmultiples submit at the next cadence check.
+        return static_cast<u32>(std::clamp(parsed, 32UL, 1'048'576UL));
+    }();
+    const u32 flush_draws = Tegra::g_nx2_ampere.load(std::memory_order_relaxed)
+                               ? native_flush_draws
+                               : DRAWS_TO_DISPATCH;
+    if (draw_counter < flush_draws) {
