+// With no depth interleaving, complete GOB block rows are contiguous guest ranges.
+// Restarting the decoder at a block-row boundary preserves both pitches and GOB offsets.
+// 3D block-depth interleaving, or a block row larger than the cap, keeps the whole path.
+template <bool swizzle>
+bool SwizzleBlockLinearSlices(Tegra::MemoryManager& gpu_memory, GPUVAddr gpu_addr,
+                              std::span<u8> output, std::span<const u8> input,
+                              u32 bytes_per_block, const Extent3D& tiles, const Extent3D& block,
+                              u32 stride_alignment, Common::ScratchBuffer<u8>& scratch) {
+    if (tiles.depth != 1 || block.depth != 0) return false;
+    const u32 rows_per_band = GOB_SIZE_Y << block.height;
+    const size_t row_bytes = size_t{Common::AlignUpLog2(tiles.width, stride_alignment)} * bytes_per_block;
+    const size_t band_bytes = Common::DivCeil(row_bytes, size_t{GOB_SIZE_X}) *
+                              (size_t{GOB_SIZE} << block.height);
+    if (band_bytes == 0 || band_bytes > MaxSwizzleScratchBytes) return false;
+    if (scratch.capacity() > MaxSwizzleScratchBytes) scratch.release();
+    const u32 bands_per_slice = static_cast<u32>(MaxSwizzleScratchBytes / band_bytes);
+    const u32 num_bands = Common::DivCeil(tiles.height, rows_per_band);
+    for (u32 band = 0; band < num_bands;) {
+        const u32 bands = (std::min)(bands_per_slice, num_bands - band);
+        const u32 y = band * rows_per_band;
+        const u32 height = (std::min)(bands * rows_per_band, tiles.height - y);
+        const size_t guest_offset = size_t{band} * band_bytes;
+        const size_t host_offset = size_t{y} * tiles.width * bytes_per_block;
+        const size_t bytes = size_t{bands} * band_bytes;
+        scratch.resize_destructive(bytes);
+        // Read before swizzling too: texels outside the image and row padding must survive.
+        gpu_memory.ReadBlockUnsafe(gpu_addr + guest_offset, scratch.data(), bytes);
+        if constexpr (swizzle) {
+            SwizzleTexture(scratch, input.subspan(host_offset), bytes_per_block, tiles.width,
+                           height, 1, block.height, 0, stride_alignment, gpu_memory.UsesNativeTiling());
+            gpu_memory.WriteBlockUnsafe(gpu_addr + guest_offset, scratch.data(), bytes);
+        } else {
+            UnswizzleTexture(output.subspan(host_offset), scratch, bytes_per_block, tiles.width,
+                             height, 1, block.height, 0, stride_alignment, gpu_memory.UsesNativeTiling());
+        }
+        band += bands;
+    }
+    return true;
+}
