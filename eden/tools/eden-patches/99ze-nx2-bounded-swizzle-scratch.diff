+namespace {
+// VMA reports real VkDeviceMemory block sizes, including unused space in those blocks.
+// Callbacks cannot allocate or query VMA again: it may hold its own allocator locks.
+static_assert(std::atomic<u64>::is_always_lock_free);
+std::atomic<u64> vma_device_bytes{0};
+void VKAPI_PTR TrackVmaAllocate(VmaAllocator, u32, VkDeviceMemory, VkDeviceSize bytes, void*) {
+    vma_device_bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+void VKAPI_PTR TrackVmaFree(VmaAllocator, u32, VkDeviceMemory, VkDeviceSize bytes, void*) {
+    vma_device_bytes.fetch_sub(bytes, std::memory_order_relaxed);
+}
+const VmaDeviceMemoryCallbacks memory_callbacks{TrackVmaAllocate, TrackVmaFree, nullptr};
+}
+extern "C" u64 eden_vulkan_memory_bytes() noexcept {
+    return vma_device_bytes.load(std::memory_order_relaxed);
+}
+#endif
