diff --git a/src/core/load_trace.h b/src/core/load_trace.h
new file mode 100644
--- /dev/null
+++ b/src/core/load_trace.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+// Optional frontend hook; ordinary core builds need no tracing provider.
+#if defined(__GNUC__) || defined(__clang__)
+extern "C" void eden_load_step(const char*, const char*) __attribute__((weak));
+#endif
+namespace Eden::LoadTrace {
+inline void Step(const char* stage, const char* detail = "") {
+#if defined(__GNUC__) || defined(__clang__)
+    if (eden_load_step) eden_load_step(stage, detail);
+#else
+    (void)stage;
+    (void)detail;
+#endif
+}
+}
