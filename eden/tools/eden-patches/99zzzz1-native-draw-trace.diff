+template <class P>
+std::string BufferCache<P>::Nx2TraceDrawBuffers(bool is_indexed, u32 first, u32 count) {
+    const auto& regs = maxwell3d->regs;
+    const auto& draw_state = maxwell3d->draw_manager.draw_state;
+    std::string text;
+    const auto flags = [&](DAddr address, u64 size) {
+        if (address == 0 || size == 0) return std::string{"-"};
+        return fmt::format("{}{}", IsRegionGpuModified(address, size) ? "G" : "g",
+                           IsRegionCpuModified(address, size) ? "C" : "c");
+    };
+    // Indices: the guest words, their range, and the highest vertex they name.
+    u64 highest_vertex = u64{first} + count;
+    if (is_indexed) {
+        const auto& index = draw_state.index_buffer;
+        const u32 index_size = static_cast<u32>(index.FormatSizeInBytes());
+        const Binding& binding = channel_state->index_buffer;
+        const GPUVAddr start = index.StartAddress() + u64{index.first} * index_size;
+        const u32 read = std::min<u32>(index.count, 4096);
+        std::vector<u8> bytes(size_t{read} * index_size);
+        u32 lowest = ~0u, highest = 0;
+        std::string words;
+        if (read && gpu_memory->IsFullyMappedRange(start, bytes.size())) {
+            gpu_memory->ReadBlockUnsafe(start, bytes.data(), bytes.size());
+            for (u32 i = 0; i < read; ++i) {
+                u32 value = 0;
+                std::memcpy(&value, bytes.data() + size_t{i} * index_size, index_size);
+                lowest = std::min(lowest, value);
+                highest = std::max(highest, value);
+                if (i < 12) words += fmt::format(" {}", value);
+            }
+        }
+        highest_vertex = u64{highest} + 1 + static_cast<s32>(draw_state.base_index);
+        text += fmt::format(" index=[gpu {:#x} format {} first {} count {} inline {} bound {:#x}+{:#x} {} "
+                            "range {}..{} words{}]",
+                            index.StartAddress(), static_cast<u32>(index.format), index.first, index.count,
+                            draw_state.inline_index_draw_indexes.size(), binding.device_addr, binding.size,
+                            flags(binding.device_addr, binding.size), lowest == ~0u ? 0 : lowest, highest,
+                            words);
+    }
+    // Attributes that read a stream (the constant ones read none).
+    for (u32 i = 0; i < regs.vertex_attrib_format.size(); ++i) {
+        const auto& attribute = regs.vertex_attrib_format[i];
+        if (attribute.hex == 0) continue;
+        text += fmt::format(" attr{}=[{:#010x} stream {} offset {} size {:#x} type {}{}]", i, attribute.hex,
+                            attribute.buffer.Value(), attribute.offset.Value(),
+                            static_cast<u32>(attribute.size.Value()), static_cast<u32>(attribute.type.Value()),
+                            attribute.constant ? " constant" : "");
+    }
+    for (u32 index = 0; index < NUM_VERTEX_BUFFERS; ++index) {
+        const auto& stream = regs.vertex_streams[index];
+        if (!stream.enable) continue;
+        const Binding& binding = channel_state->vertex_buffers[index];
+        const u32 stride = stream.stride;
+        const bool instanced = regs.vertex_stream_instances.IsInstancingEnabled(index);
+        const u64 needed = instanced ? 0 : highest_vertex * stride;
+        const auto& synced = nx2_synced_vertex_buffers[index];
+        const u64 epoch = binding.device_addr ? memory_tracker.CpuWriteEpoch(binding.device_addr, binding.size) : 0;
+        text += fmt::format(" stream{}=[gpu {:#x} stride {} instanced {} frequency {} native_size {:#x} bound {:#x}+{:#x} "
+                            "needs {:#x}{} {} epoch {} synced {}",
+                            index, stream.Address(), stride, instanced, stream.frequency,
+                            regs.NativeVertexStreamSize(index), binding.device_addr, binding.size, needed,
+                            needed > binding.size ? " SHORT" : "", flags(binding.device_addr, binding.size),
+                            epoch == ~u64{0} ? -1 : static_cast<s64>(epoch),
+                            synced.epoch == ~u64{0} ? -1 : static_cast<s64>(synced.epoch));
+        // The first 16 bytes of a few vertices: 0-3 (the first quad), 4-7 and the last one.
+        const u32 vertex_first = is_indexed ? static_cast<u32>(std::max<s64>(0, static_cast<s32>(draw_state.base_index))) : first;
+        const u32 last = static_cast<u32>(std::max<u64>(highest_vertex, 1) - 1);
+        for (const u32 vertex : {vertex_first, vertex_first + 1, vertex_first + 2, vertex_first + 4,
+                                 vertex_first + 6, vertex_first + 8, last}) {
+            if (stride == 0 && vertex != vertex_first) break;
+            const GPUVAddr address = stream.Address() + u64{vertex} * stride;
+            std::array<u32, 4> words{};
+            if (!gpu_memory->IsFullyMappedRange(address, sizeof(words))) continue;
+            gpu_memory->ReadBlockUnsafe(address, words.data(), sizeof(words));
+            text += fmt::format(" v{}:{:08x}", vertex, fmt::join(words, ","));
+        }
+        text += "]";
+    }
+    return text;
+}
