+// Opt-in draw trace (native_draw_trace.h, /data/eden-nx2/trace-draws.txt on the PS5): one line per
+// draw whose vertex or pixel shader has a traced key, for a few frames.
+template <class BufferCacheT>
+void TraceNativeDraw(Tegra::Engines::Maxwell3D& maxwell3d, Tegra::MemoryManager& gpu_memory,
+                     BufferCacheT& buffer_cache, bool is_indexed, u32 instance_count,
+                     const DrawParams* draw_params,
+                     const Tegra::Engines::Maxwell3D::DrawManager::IndirectParams* indirect) {
+    namespace Trace = VideoCommon::NativeDrawTrace;
+    const auto& regs = maxwell3d.regs;
+    const auto program = [&](size_t stage) -> u64 {
+        if (!regs.IsShaderConfigEnabled(stage)) return 0;
+        return (u64{regs.pipelines[stage].reserved[0] & 0xff} << 32) | regs.pipelines[stage].reserved[1];
+    };
+    std::optional<u64> key;
+    u64 traced_program = 0;
+    for (const size_t stage : {size_t{1}, size_t{0}, size_t{5}}) {
+        if ((key = Trace::TracedKeyAt(program(stage)))) {
+            traced_program = program(stage);
+            break;
+        }
+    }
+    if (!key || !Trace::ShouldLog()) return;
+    const auto& draw_state = maxwell3d.draw_manager.draw_state;
+    const auto& macro = Trace::current_macro;
+    const auto gpu_flag = [&](GPUVAddr address, u64 size) -> std::string {
+        if (address == 0) return "inline";
+        const auto device = gpu_memory.GpuToCpuAddress(address);
+        if (!device) return "unmapped";
+        return buffer_cache.IsRegionGpuModified(*device, size) ? "gpu-modified" : "guest";
+    };
+    std::string kind = indirect ? "indirect" : "direct";
+    if (macro.active) kind += "+macro";
+    if (maxwell3d.engine_state == Tegra::Engines::Maxwell3D::EngineHint::OnHLEMacro) kind += "+hle";
+    if (draw_state.draw_mode == Tegra::Engines::Maxwell3D::DrawManager::DrawMode::Instance) kind += "+instanced-mode";
+    if (draw_state.draw_mode == Tegra::Engines::Maxwell3D::DrawManager::DrawMode::InlineIndex) kind += "+inline-index";
+    std::string line = fmt::format(
+        "NX2_DRAW_TRACE frame={} key={:016x} program={:#x} vs={:#x} ps={:#x} kind={} indexed={} topology={} "
+        "vertex_first={} vertex_count={} index_first={} index_count={} base_vertex={} base_instance={} "
+        "instances={}",
+        Trace::frame.load(std::memory_order_relaxed), *key, traced_program, program(1), program(5), kind,
+        is_indexed, static_cast<u32>(draw_state.topology), draw_state.vertex_buffer.first,
+        draw_state.vertex_buffer.count, draw_state.index_buffer.first, draw_state.index_buffer.count,
+        static_cast<s32>(draw_state.base_index), draw_state.base_instance, instance_count);
+    if (draw_params) {
+        line += fmt::format(" host=[vertices {} instances {} first_index {} base_vertex {} base_instance {} indexed {}]",
+                            draw_params->num_vertices, draw_params->num_instances, draw_params->first_index,
+                            static_cast<s32>(draw_params->base_vertex), draw_params->base_instance,
+                            draw_params->is_indexed);
+    }
+    if (indirect) {
+        std::array<u32, 5> words{};
+        if (gpu_memory.IsFullyMappedRange(indirect->indirect_start_address, sizeof(words)))
+            gpu_memory.ReadBlockUnsafe(indirect->indirect_start_address, words.data(), sizeof(words));
+        line += fmt::format(" indirect=[address {:#x} guest {:08x} {} byte_count {} include_count {} max_draws {} stride {} buffer_size {:#x}]",
+                            indirect->indirect_start_address, fmt::join(words, ","),
+                            gpu_flag(indirect->indirect_start_address, sizeof(words)), indirect->is_byte_count,
+                            indirect->include_count, indirect->max_draw_counts, indirect->stride,
+                            indirect->buffer_size);
+        if (indirect->include_count) {
+            u32 count = 0;
+            if (gpu_memory.IsFullyMappedRange(indirect->count_start_address, sizeof(count)))
+                gpu_memory.ReadBlockUnsafe(indirect->count_start_address, &count, sizeof(count));
+            line += fmt::format(" count=[address {:#x} guest {} {}]", indirect->count_start_address, count,
+                                gpu_flag(indirect->count_start_address, sizeof(count)));
+        }
+    }
+    if (macro.active) {
+        line += fmt::format(" macro=[method {:#x} params {} dirty {}", macro.method, macro.parameter_count,
+                            macro.refreshed);
+        for (u32 i = 0; i < macro.parameter_count && i < macro.parameters.size(); ++i) {
+            line += fmt::format(" {:#x}", macro.parameters[i]);
+            if (macro.addresses[i]) line += fmt::format("@{:#x}:{}", macro.addresses[i], gpu_flag(macro.addresses[i], 4));
+        }
+        line += "]";
+    }
+    line += buffer_cache.Nx2TraceDrawBuffers(is_indexed, draw_state.vertex_buffer.first, draw_state.vertex_buffer.count);
+    LOG_WARNING(HW_GPU, "{}", line);
+}
