new file mode 100644
index 0000000..28fadcd
--- /dev/null
+++ b/src/video_core/native_draw_trace.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+// Opt-in draw trace for chosen native shaders (EDEN_NX2_TRACE_DRAW_KEYS, set by the PS5 frontend
+// from /data/eden-nx2/trace-draws.txt). A native shader's key is computed when it is lowered
+// (shader_environment.cpp); the program address -> key table lets the rasterizer tell, at draw
+// time, that a draw uses a traced shader and log its parameters, the macro that issued it and its
+// vertex and index buffers. With the variable unset, Enabled() is one load of a static and nothing
+// else runs.
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include "common/common_types.h"
+
+namespace VideoCommon::NativeDrawTrace {
+
+struct Keys {
+    std::unordered_set<u64> keys;
+    bool enabled{};
+};
+
+inline const Keys& TracedKeys() {
+    static const Keys keys = [] {
+        Keys result;
+        const char* value = std::getenv("EDEN_NX2_TRACE_DRAW_KEYS");
+        if (!value) return result;
+        std::string text{value};
+        for (char& c : text) if (c == ',' || c == ';' || c == '\n') c = ' ';
+        size_t position = 0;
+        while (position < text.size()) {
+            while (position < text.size() && text[position] == ' ') ++position;
+            const size_t end = text.find(' ', position);
+            const std::string word = text.substr(position, end == std::string::npos ? std::string::npos : end - position);
+            if (!word.empty()) {
+                char* stop = nullptr;
+                const u64 key = std::strtoull(word.c_str(), &stop, 16);
+                if (stop && *stop == '\0') result.keys.insert(key);
+            }
+            if (end == std::string::npos) break;
+            position = end + 1;
+        }
+        result.enabled = !result.keys.empty();
+        return result;
+    }();
+    return keys;
+}
+
+inline bool Enabled() {
+    return TracedKeys().enabled;
+}
+
+struct ProgramTable {
+    std::mutex mutex;
+    std::unordered_map<u64, u64> key_by_address;
+};
+
+inline ProgramTable& Programs() {
+    static ProgramTable table;
+    return table;
+}
+
+/// Called when a native shader is lowered: remembers which key the program at this address has.
+inline void RecordProgram(u64 program_address, u64 key) {
+    if (!Enabled()) return;
+    auto& table = Programs();
+    std::scoped_lock lock{table.mutex};
+    table.key_by_address[program_address] = key;
+}
+
+/// The key of the native program at this address, if one was lowered there and it is traced.
+inline std::optional<u64> TracedKeyAt(u64 program_address) {
+    if (!Enabled() || program_address == 0) return std::nullopt;
+    auto& table = Programs();
+    std::scoped_lock lock{table.mutex};
+    const auto it = table.key_by_address.find(program_address);
+    if (it == table.key_by_address.end() || !TracedKeys().keys.contains(it->second)) return std::nullopt;
+    return it->second;
+}
+
+/// Frames counted by RasterizerVulkan::TickFrame.
+inline std::atomic<u64> frame{};
+
+/// The macro being executed on this thread (the draws it issues run on the same thread with
+/// EDEN_NX2_SPLIT=1, the PS5 default): its method, first parameters, and where the parameters
+/// were read from (0 = inline in the command list).
+struct MacroContext {
+    u32 method{};
+    u32 parameter_count{};
+    std::array<u32, 24> parameters{};
+    std::array<u64, 24> addresses{};
+    bool active{};
+    bool refreshed{};
+};
+inline thread_local MacroContext current_macro{};
+
+/// Which draws of which frames are logged: every traced draw of the first two frames that have
+/// one, then of one frame every 120 frames, eight frames in all, at most 64 draws a frame.
+struct Budget {
+    u64 last_frame{~u64{0}};
+    u64 last_logged_frame{};
+    u32 frames_logged{};
+    u32 draws_this_frame{};
+    bool logging_this_frame{};
+};
+
+inline bool ShouldLog() {
+    static std::mutex mutex;
+    static Budget budget;
+    std::scoped_lock lock{mutex};
+    const u64 now = frame.load(std::memory_order_relaxed);
+    if (now != budget.last_frame) {
+        budget.last_frame = now;
+        budget.draws_this_frame = 0;
+        budget.logging_this_frame =
+            budget.frames_logged < 8 &&
+            (budget.frames_logged < 2 || now - budget.last_logged_frame >= 120);
+        if (budget.logging_this_frame) {
+            ++budget.frames_logged;
+            budget.last_logged_frame = now;
+        }
+    }
+    return budget.logging_this_frame && budget.draws_this_frame++ < 64;
+}
+
+} // namespace VideoCommon::NativeDrawTrace
