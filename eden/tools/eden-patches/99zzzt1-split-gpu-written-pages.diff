diff --git a/src/video_core/gpu_written_pages.h b/src/video_core/gpu_written_pages.h
new file mode 100644
index 0000000..1bd2ab8
--- /dev/null
+++ b/src/video_core/gpu_written_pages.h
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+
+#include "common/common_types.h"
+
+// Device pages the emulated GPU may have written (GPU thread split, gpu_split.h). The split's
+// back thread marks a page when the buffer cache or the texture cache records a GPU write in
+// it, when a query or semaphore result is queued for it, and when an engine writes guest memory
+// through the memory manager. Marks are never cleared: a page that was written once stays
+// "written". The front reads the bits without taking any lock, to decide whether a command list
+// segment can be read straight from guest memory (see dma_pusher.cpp). Pages outside the 36-bit
+// device address space count as written.
+// Idea from Lichii (github.com/zortos293/Lichii) PR #179: the GPU-written page bitmap and the
+// "no new page written for a while" counter behind EDEN_NX2_LIST_FAST. Written for this core.
+namespace VideoCommon::GpuWrittenPages {
+
+inline constexpr u64 PageBits = 12;
+inline constexpr u64 PageCount = u64{1} << (36 - PageBits);
+inline std::array<std::atomic<u64>, PageCount / 64> bits{};
+/// Changes whenever a page is marked for the first time.
+inline std::atomic<u64> new_marks{};
+
+inline void Mark(u64 device_address, u64 size) noexcept {
+    if (size == 0) {
+        return;
+    }
+    const u64 first = device_address >> PageBits;
+    if (first >= PageCount) {
+        return;
+    }
+    const u64 last = std::min<u64>((device_address + size - 1) >> PageBits, PageCount - 1);
+    // A word at a time: buffer cache marks can span megabytes, mostly marked already.
+    for (u64 page = first; page <= last;) {
+        const u64 first_bit = page % 64;
+        const u64 count = std::min<u64>(64 - first_bit, last - page + 1);
+        const u64 mask = (count == 64 ? ~u64{0} : ((u64{1} << count) - 1)) << first_bit;
+        auto& word = bits[page / 64];
+        if ((word.load(std::memory_order_relaxed) & mask) != mask) {
+            if ((word.fetch_or(mask, std::memory_order_acq_rel) & mask) != mask) {
+                new_marks.fetch_add(1, std::memory_order_release);
+            }
+        }
+        page += count;
+    }
+}
+
+/// Whether any page of [device_address, device_address + size) is marked.
+[[nodiscard]] inline bool Any(u64 device_address, u64 size) noexcept {
+    if (size == 0) {
+        return false;
+    }
+    const u64 first = device_address >> PageBits;
+    const u64 last = (device_address + size - 1) >> PageBits;
+    if (last >= PageCount || last < first) {
+        return true;
+    }
+    for (u64 page = first; page <= last; ++page) {
+        if (bits[page / 64].load(std::memory_order_acquire) & (u64{1} << (page % 64))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace VideoCommon::GpuWrittenPages
