OoT's menu text: shadow every form of the common integer and float ALU operations next to the
extended uniform bank, not only the forms 99zzzw listed. The operand form (bits 9-11) places the
register operands, so IMAD.HI with an immediate (0x827), where the last menu-text compute shader
stopped on 00.067.002, and the other immediate, constant and uniform forms are covered. Bumps the
translator salt.

--- a/src/shader_recompiler/frontend/ampere/register_pressure.h
+++ b/src/shader_recompiler/frontend/ampere/register_pressure.h
@@ -96,9 +96,54 @@
         operand(16, channels > 1 ? 2 : 1); operand(24, input.Bits(61, 3) == 5 ? 3 : 2);
         operand(32, 4); operand(64, 2); break;
     }
-    default:
-        result.valid = false; return result;
+    default: {
+        // Any other form of a known integer or float ALU operation: the low nine bits name the
+        // operation and bits 9-11 the operand form, which places the register operands. Form 1 is
+        // register B (32) and C (64); forms 2-3 put an immediate or constant in C, so B moves to 64;
+        // forms 4-6 put an immediate, constant or uniform register in B, and C stays at 64. A
+        // two-source operation has no C, so only form 1 names a register in B. OoT's last menu-text
+        // compute shader reached IMAD.HI R1, R208, 0x38e38e39 (0x827), which no case above listed.
+        enum class Shape { None, Move, Compare, Two, Three, Wide, High };
+        const u32 base = opcode & 0x1ff, form = opcode >> 9;
+        Shape shape = Shape::None;
+        switch (base) {
+        case 0x002: shape = Shape::Move; break;                          // MOV
+        case 0x00b: case 0x00c: shape = Shape::Compare; break;           // FSETP, ISETP
+        case 0x007: case 0x008: case 0x009: case 0x017:                  // SEL, FSEL, FMNMX, IMNMX
+        case 0x020: case 0x021: shape = Shape::Two; break;               // FMUL, FADD
+        case 0x010: case 0x011: case 0x012: case 0x016: case 0x019:      // IADD3, LEA, LOP3, PRMT, SHF
+        case 0x023: case 0x024: shape = Shape::Three; break;             // FFMA, IMAD
+        case 0x025: shape = Shape::Wide; break;                          // IMAD.WIDE
+        case 0x027: shape = Shape::High; break;                          // IMAD.HI (64-bit addend)
+        default: break;
+        }
+        if (shape == Shape::None || form == 0 || form == 7) {
+            result.valid = false; return result;
+        }
+        const bool register_b = form == 1;
+        const bool register_c_only = form >= 4;  // B is not a GPR, C is at 64
+        switch (shape) {
+        case Shape::Move:
+            operand(16); if (register_b) operand(32); break;
+        case Shape::Compare:
+            operand(24); if (register_b) operand(32); break;
+        case Shape::Two:
+            operand(16); operand(24); if (register_b) operand(32); break;
+        case Shape::Three:
+            operand(16); operand(24); if (register_b) operand(32); operand(64); break;
+        case Shape::Wide:
+        case Shape::High: {
+            operand(16, shape == Shape::Wide ? 2 : 1); operand(24);
+            if (register_b) { operand(32); operand(64, 2); }
+            else if (register_c_only) operand(64, 2);
+            else operand(64);  // forms 2-3: B at 64, the addend is the immediate or constant
+            break;
+        }
+        case Shape::None: break;
+        }
+        break;
     }
+    }
