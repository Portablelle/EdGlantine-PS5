diff --git a/src/video_core/position_capture_gate.h b/src/video_core/position_capture_gate.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/position_capture_gate.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <set>
+
+namespace Eden {
+class PositionCaptureGate {
+public:
+    void Reset(unsigned new_scope, unsigned initial_skip = 0) {
+        scope = new_scope;
+        observed = 0;
+        budget = 2048 + std::min(initial_skip, 16384U);
+        programs.clear();
+    }
+    bool Accept(float scale_x, float scale_y, std::uint64_t vertex,
+                std::uint64_t fragment, bool eligible) {
+        if (++observed > budget) return false;
+        if (!eligible) return false;
+        if (scope >= 2 && !((scale_x == 960.f || scale_x == -960.f) &&
+                            (scale_y == 540.f || scale_y == -540.f))) return false;
+        return scope != 3 || programs.insert({vertex, fragment}).second;
+    }
+    bool Exhausted() const { return observed > budget; }
+private:
+    unsigned scope{}, observed{}, budget{2048};
+    std::set<std::array<std::uint64_t, 2>> programs;
+};
+} // namespace Eden
