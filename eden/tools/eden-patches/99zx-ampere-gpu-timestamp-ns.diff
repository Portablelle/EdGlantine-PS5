diff --git a/src/video_core/gpu_timestamp.h b/src/video_core/gpu_timestamp.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/gpu_timestamp.h
@@ -0,0 +1,27 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include "common/common_types.h"
+#include "common/settings_enums.h"
+
+namespace Tegra {
+
+template <typename Timing>
+[[nodiscard]] u64 ReadGpuTimestamp(const Timing& timing, bool ampere, Settings::GpuClock clock) {
+    if (ampere) {
+        return static_cast<u64>(timing.GetGlobalTimeNs().count());
+    }
+    const u64 ticks = timing.GetGPUTicks();
+    switch (clock) {
+    case Settings::GpuClock::Boost:
+        return ticks / 256;
+    case Settings::GpuClock::Overclock:
+        return ticks / 512;
+    default:
+        return ticks;
+    }
+}
+
+} // namespace Tegra
