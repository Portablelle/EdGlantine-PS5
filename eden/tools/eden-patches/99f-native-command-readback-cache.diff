diff --git a/src/video_core/native_dma_snapshot.h b/src/video_core/native_dma_snapshot.h
--- a/src/video_core/native_dma_snapshot.h
+++ b/src/video_core/native_dma_snapshot.h
@@ -2,16 +2,37 @@
 #pragma once
 #include <cstddef>
 #include "common/common_types.h"
+#ifdef EDEN_NX2_PS5_PROTO
+#include "video_core/buffer_cache/readback_cache.h"
+#endif
 
 namespace Tegra {
+// Own the command bytes before parsing, but permit the existing GPU-write-
+// invalidated readback cache for small contiguous coherent command reads only.
+// The scope ends before parsing can prepare writers or suspend an acquire.
+template <class Memory>
+void ReadNativeDmaCommandSnapshot(Memory& memory, GPUVAddr address, void* destination,
+                                   std::size_t bytes, bool coherent) {
+    if (!coherent) {
+        memory.ReadBlockUnsafe(address, destination, bytes);
+        return;
+    }
+#ifdef EDEN_NX2_PS5_PROTO
+    const auto device = bytes && bytes <= 4096 ? memory.GpuToCpuAddress(address) : std::nullopt;
+    const bool eligible = device && memory.IsContinuousRange(address, bytes);
+    const VideoCommon::ParameterReadbackScope readback_scope{
+        device.value_or(0), bytes, eligible, true};
+#endif
+    memory.ReadBlock(address, destination, bytes);
+}
+
 // The split backend owns the cache. Invoke there, after preceding engine work,
 // and retain the owned destination across any suspended acquire in the parser.
 template <class Memory>
 bool ReadOwnedNativeDmaSnapshot(Memory& memory, GPUVAddr address, void* destination,
                                 std::size_t bytes, bool safe) {
     const bool dirty = memory.IsMemoryDirty(address, bytes);
-    if (safe || dirty) memory.ReadBlock(address, destination, bytes);
-    else memory.ReadBlockUnsafe(address, destination, bytes);
+    ReadNativeDmaCommandSnapshot(memory, address, destination, bytes, safe || dirty);
     return dirty;
 }
 } // namespace Tegra
