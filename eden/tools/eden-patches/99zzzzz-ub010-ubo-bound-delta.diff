diff --git a/src/video_core/buffer_cache/uniform_keep.h b/src/video_core/buffer_cache/uniform_keep.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/buffer_cache/uniform_keep.h
@@ -0,0 +1,178 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <bit>
+#include <concepts>
+#include <cstddef>
+#include <type_traits>
+#include <utility>
+
+#include "common/common_types.h"
+
+// Uniform keeps (Lichii #1441, #1521): a graphics draw binds a small streamed uniform buffer from
+// the stream allocation an earlier draw of the same command buffer made for its slot and range,
+// without reading guest memory again, while nothing that could have changed those bytes happened
+// in between. What ends a keep:
+//  - a write the caches hear of over the range: everything reaching BufferCache::WriteMemory
+//    (CPU writes, InnerInvalidation of constant buffer data, ...) and downloads of GPU data end it
+//    in the memory tracker; DMA copies and clears and inline uploads end it even when they take
+//    the fallback path (BufferCache::NoteUniformWrite); GPU-modified pages are never kept;
+//  - constant buffer data or a rebind of the slot since the previous draw (Delta);
+//  - a point where the guest CPU may have synchronised with the GPU (NoteSync): fences, syncpoints,
+//    semaphores and reports, acquires, frames and each submitted command list. Streamed uniform
+//    pages are not write-protected, so CPU writes after one go unseen;
+//  - another GPU address space or a page table change (even at an equal map serial), a buffer
+//    deletion, a new command buffer, or a delta that lost writes (overflow).
+namespace VideoCommon::UniformKeeps {
+
+inline std::atomic<u64> g_sync_serial{1};
+
+/// The guest CPU may have synchronised with the GPU: keeps made before end.
+inline void NoteSync() {
+    g_sync_serial.fetch_add(1, std::memory_order_release);
+}
+
+[[nodiscard]] inline u64 SyncSerial() {
+    return g_sync_serial.load(std::memory_order_acquire);
+}
+
+/// Constant buffer binds and data (device ranges) since the previous graphics draw. Written and
+/// taken on the thread that runs the 3D engine and the rasterizer.
+struct Delta {
+    static constexpr u32 MaxWrites = 16;
+    static constexpr size_t NumStages = 5;
+
+    std::array<u32, NumStages> binds{};
+    std::array<DAddr, MaxWrites> device_begin{};
+    std::array<DAddr, MaxWrites> device_end{};
+    u32 num_device_writes{};
+    /// A write did not fit: the list misses some, so the draw keeps nothing.
+    bool overflow{};
+};
+
+inline Delta g_delta;
+
+/// Graphics uniform slots whose last stream allocation still holds guest memory at their range.
+/// The buffer cache sets them; its memory tracker ends them where guest memory changes (CPU
+/// writes it is told of, downloads of GPU data). Both under the buffer cache lock.
+struct CleanSlots {
+    static constexpr u32 NumSlots = 32;
+    std::array<u32, Delta::NumStages> mask{};
+    std::array<std::array<std::pair<DAddr, DAddr>, NumSlots>, Delta::NumStages> ranges{};
+    DAddr low = ~DAddr{0}; ///< Bounds of the ranges kept since the last ForgetAll
+    DAddr high{};
+};
+
+inline CleanSlots g_clean;
+
+inline void Keep(size_t stage, u32 index, DAddr begin, DAddr end) noexcept {
+    CleanSlots& clean = g_clean;
+    clean.mask[stage] |= 1u << index;
+    clean.ranges[stage][index] = {begin, end};
+    clean.low = (std::min)(clean.low, begin);
+    clean.high = (std::max)(clean.high, end);
+}
+
+inline void Forget(size_t stage, u32 index) noexcept {
+    g_clean.mask[stage] &= ~(1u << index);
+}
+
+inline void ForgetAll() noexcept {
+    g_clean.mask = {};
+    g_clean.low = ~DAddr{0};
+    g_clean.high = 0;
+}
+
+[[nodiscard]] inline bool IsClean(size_t stage, u32 index, DAddr begin, DAddr end) noexcept {
+    const CleanSlots& clean = g_clean;
+    return ((clean.mask[stage] >> index) & 1) != 0 &&
+           clean.ranges[stage][index] == std::pair<DAddr, DAddr>{begin, end};
+}
+
+/// Guest memory over [address, address + size) may differ from what was streamed: ends the
+/// keeps over it.
+inline void NoteWrite(DAddr address, u64 size) noexcept {
+    CleanSlots& clean = g_clean;
+    const DAddr end = address + size;
+    if (end <= clean.low || clean.high <= address) {
+        return;
+    }
+    for (size_t stage = 0; stage < Delta::NumStages; ++stage) {
+        for (u32 mask = clean.mask[stage]; mask != 0; mask &= mask - 1) {
+            const u32 index = static_cast<u32>(std::countr_zero(mask));
+            const auto [begin, range_end] = clean.ranges[stage][index];
+            if (address < range_end && begin < end) {
+                clean.mask[stage] &= ~(1u << index);
+            }
+        }
+    }
+}
+
+inline void NoteBind(size_t stage, u32 index) {
+    if (stage < Delta::NumStages && index < 32) {
+        g_delta.binds[stage] |= 1u << index;
+    }
+}
+
+/// Adds [begin, end) to g_delta, merged with a range it touches.
+inline void NoteDeviceData(DAddr begin, DAddr end) {
+    Delta& delta = g_delta;
+    for (u32 i = 0; i < delta.num_device_writes; ++i) {
+        if (begin <= delta.device_end[i] && delta.device_begin[i] <= end) {
+            delta.device_begin[i] = (std::min)(delta.device_begin[i], begin);
+            delta.device_end[i] = (std::max)(delta.device_end[i], end);
+            return;
+        }
+    }
+    if (delta.num_device_writes == Delta::MaxWrites) {
+        delta.overflow = true;
+        return;
+    }
+    delta.device_begin[delta.num_device_writes] = begin;
+    delta.device_end[delta.num_device_writes] = end;
+    ++delta.num_device_writes;
+}
+
+/// Moves g_delta into `out` and clears it, copying only the bind masks and the write ranges in
+/// use (not the whole Delta, which every draw takes).
+inline void TakeDelta(Delta& out) {
+    Delta& delta = g_delta;
+    out.binds = delta.binds;
+    out.num_device_writes = delta.num_device_writes;
+    std::copy_n(delta.device_begin.begin(), delta.num_device_writes, out.device_begin.begin());
+    std::copy_n(delta.device_end.begin(), delta.num_device_writes, out.device_end.begin());
+    out.overflow = delta.overflow;
+    delta.binds = {};
+    delta.num_device_writes = 0;
+    delta.overflow = false;
+}
+
+/// A buffer cache runtime whose streamed uniform allocations can be bound again in the same
+/// command buffer: StreamUniformRef describes one, LastStreamUniformRef is the latest
+/// BindMappedUniformBuffer's, RebindStreamUniform adds it to the descriptors as that call did.
+template <class R>
+concept StreamUniformRebindable = requires(R& runtime, u32 size) {
+    typename R::StreamUniformRef;
+    requires std::is_trivially_copyable_v<typename R::StreamUniformRef>;
+    { runtime.LastStreamUniformRef() } -> std::same_as<typename R::StreamUniformRef>;
+    runtime.RebindStreamUniform(runtime.LastStreamUniformRef(), size);
+    { runtime.CurrentTick() } -> std::convertible_to<u64>;
+};
+
+template <class R>
+struct StreamRef {
+    using type = u64; // Unused: the runtime can't rebind, so nothing is kept
+};
+
+template <class R>
+    requires StreamUniformRebindable<R>
+struct StreamRef<R> {
+    using type = typename R::StreamUniformRef;
+};
+
+} // namespace VideoCommon::UniformKeeps
