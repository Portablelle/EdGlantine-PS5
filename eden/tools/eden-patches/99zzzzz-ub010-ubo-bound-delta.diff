+template <class P>
+void BufferCache<P>::BeginGraphicsUniforms() {
+    static_assert(NUM_STAGES == UniformKeeps::Delta::NumStages);
+    UniformKeep& keep = uniform_keep;
+    UniformKeeps::TakeDelta(keep.delta);
+    const UniformKeeps::Delta& delta = keep.delta;
+    const u64 sync_serial = UniformKeeps::SyncSerial();
+    const u64 map_serial = gpu_memory != nullptr ? gpu_memory->MapSerial() : 0;
+    const bool unchanged = !delta.overflow && keep.sync_serial == sync_serial &&
+                           keep.gpu_memory == gpu_memory && keep.map_serial == map_serial &&
+                           keep.deletions == buffer_deletions;
+    keep.sync_serial = sync_serial;
+    keep.gpu_memory = gpu_memory;
+    keep.map_serial = map_serial;
+    keep.deletions = buffer_deletions;
+    if (!unchanged) {
+        UniformKeeps::ForgetAll();
+        return;
+    }
+    for (size_t stage = 0; stage < NUM_STAGES; ++stage) {
+        for (u32 mask = delta.binds[stage]; mask != 0; mask &= mask - 1) {
+            UniformKeeps::Forget(stage, static_cast<u32>(std::countr_zero(mask)));
+        }
+    }
+    for (u32 write = 0; write < delta.num_device_writes; ++write) {
+        NoteUniformWrite(delta.device_begin[write],
+                         delta.device_end[write] - delta.device_begin[write]);
+    }
+}
+
+template <class P>
+void BufferCache<P>::NoteUniformWrite(DAddr device_addr, u64 size) noexcept {
+    UniformKeeps::NoteWrite(device_addr, size);
+}
+
+template <class P>
+bool BufferCache<P>::RebindKeptUniform(size_t stage, u32 index, u32 binding_index,
+                                       DAddr device_addr, u32 size) {
+    if constexpr (UniformKeeps::StreamUniformRebindable<Runtime>) {
+        UniformKeep& keep = uniform_keep;
+        // As the stream path: never over GPU-modified pages (their guest bytes may be stale, and
+        // cached writes there skip the CPU-modified mark that ends keeps).
+        if (UniformKeeps::IsClean(stage, index, device_addr, device_addr + size) &&
+            keep.ticks[stage][index] == static_cast<u64>(runtime.CurrentTick()) &&
+            !memory_tracker.IsRegionGpuModified(device_addr, size)) {
+            runtime.RebindStreamUniform(keep.refs[stage][index], size);
+            channel_state->fast_bound_uniform_buffers[stage] |= 1u << binding_index;
+            channel_state->uniform_buffer_binding_sizes[stage][binding_index] = size;
+            return true;
+        }
+        UniformKeeps::Forget(stage, index);
+    }
+    return false;
+}
+
+template <class P>
+void BufferCache<P>::KeepStreamedUniform(size_t stage, u32 index, DAddr device_addr, u32 size) {
+    if constexpr (UniformKeeps::StreamUniformRebindable<Runtime>) {
+        UniformKeep& keep = uniform_keep;
+        UniformKeeps::Keep(stage, index, device_addr, device_addr + size);
+        keep.refs[stage][index] = runtime.LastStreamUniformRef();
+        // After the allocation: the stream region is tagged with the tick current now.
+        keep.ticks[stage][index] = static_cast<u64>(runtime.CurrentTick());
+    }
+}
+
 template <class P>
 bool BufferCache<P>::HasFastUniformBufferBound(size_t stage, u32 binding_index) const noexcept {
     return ((channel_state->fast_bound_uniform_buffers[stage] >> binding_index) & 1u) != 0;
