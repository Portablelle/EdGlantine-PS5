+void Maxwell3D::HeaderSpans::Update(const MemoryManager& memory, GPUVAddr address_, u64 size_,
+                                    u64 map_serial_) {
+    if (known && address == address_ && size == size_ && map_serial == map_serial_) {
+        return;
+    }
+    address = address_;
+    size = size_;
+    map_serial = map_serial_;
+    known = true;
+    opaque = false;
+    count = 0;
+    // Each piece is one range of device memory.
+    for (const auto& [piece, piece_size] : memory.GetSubmappedRange(address, size)) {
+        const std::optional<DAddr> device = memory.GpuToCpuAddress(piece);
+        if (!device) {
+            continue;
+        }
+        if (count == MaxRanges) {
+            opaque = true;
+            return;
+        }
+        ranges[count++] = {*device, *device + piece_size};
+    }
+}
+
+bool Maxwell3D::HeaderSpans::Intersects(DAddr begin, DAddr end) const {
+    if (opaque) {
+        return true;
+    }
+    for (u32 i = 0; i < count; ++i) {
+        if (begin < ranges[i].second && ranges[i].first < end) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool Maxwell3D::WriteBoundConstantBuffer(u32 offset, const void* data, u32 bytes) {
+    // Texture and sampler headers: 32 bytes each, the sampler table sized as
+    // TextureCache::SynchronizeDescriptors sizes it.
+    constexpr u64 HeaderEntrySize = 0x20;
+    const GPUVAddr address = regs.const_buffer.Address();
+    const u32 size = regs.const_buffer.size;
+    if (u64{offset} + bytes > size) {
+        return false;
+    }
+    const u64 map_serial = memory_manager.MapSerial();
+    const GPUVAddr tic = regs.tex_header.Address();
+    const u64 tic_size = (u64{regs.tex_header.limit} + 1) * HeaderEntrySize;
+    const GPUVAddr tsc = regs.tex_sampler.Address();
+    const u64 tsc_size = (u64{regs.sampler_binding == Regs::SamplerBinding::ViaHeaderBinding
+                                  ? regs.tex_header.limit
+                                  : regs.tex_sampler.limit} +
+                          1) *
+                         HeaderEntrySize;
+    BoundConstantBuffer& bound = bound_constant_buffer;
+    if (bound.address != address || bound.size != size || bound.map_serial != map_serial ||
+        bound.tic != tic || bound.tic_size != tic_size || bound.tsc != tsc ||
+        bound.tsc_size != tsc_size) {
+        bound = {address, size, map_serial, tic, tic_size, tsc, tsc_size, 0};
+        const GPUVAddr end = address + size;
+        const std::optional<DAddr> device =
+            address != 0 && size != 0 && memory_manager.IsContinuousRange(address, size)
+                ? memory_manager.GpuToCpuAddress(address)
