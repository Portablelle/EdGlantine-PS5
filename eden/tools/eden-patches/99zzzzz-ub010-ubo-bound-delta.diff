+            bound_sampler_spans.Update(memory_manager, tsc, tsc_size, map_serial);
+            if (!bound_header_spans.Intersects(*device, *device + size) &&
+                !bound_sampler_spans.Intersects(*device, *device + size)) {
+                bound.device = *device;
+            }
+        }
+    }
+    if (bound.device == 0) {
+        return false;
+    }
+    const DAddr device = bound.device + offset;
+    VideoCommon::UniformKeeps::NoteDeviceData(device, device + bytes);
+    memory_manager.WriteConstantBufferData(device, data, bytes);
+    return true;
+}
