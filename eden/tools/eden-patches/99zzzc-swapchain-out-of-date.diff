Ported from Lichii #88 and the swapchain part of upstream #427 as merged in Lichii
(https://github.com/zortos293/Lichii/pull/88): wait for the device before recreating the
swapchain, present a suboptimal acquire, and recreate before presenting after an out-of-date one.

diff --git a/src/video_core/renderer_vulkan/vk_present_manager.cpp b/src/video_core/renderer_vulkan/vk_present_manager.cpp
--- a/src/video_core/renderer_vulkan/vk_present_manager.cpp
+++ b/src/video_core/renderer_vulkan/vk_present_manager.cpp
@@ -427,7 +427,7 @@ void PresentManager::CopyToSwapchainImpl(Frame* frame) {
 
     // If the size of the incoming frames has changed, recreate the swapchain
     // to account for that.
-    const bool is_suboptimal = swapchain.NeedsRecreation();
+    const bool is_suboptimal = swapchain.NeedsRecreation() || swapchain.IsOutDated();
     const bool size_changed =
         swapchain.GetWidth() != frame->width || swapchain.GetHeight() != frame->height;
     if (is_suboptimal || size_changed) {
diff --git a/src/video_core/renderer_vulkan/vk_swapchain.cpp b/src/video_core/renderer_vulkan/vk_swapchain.cpp
--- a/src/video_core/renderer_vulkan/vk_swapchain.cpp
+++ b/src/video_core/renderer_vulkan/vk_swapchain.cpp
@@ -149,6 +149,16 @@ void Swapchain::Create(
         return;
     }
 
+    // Submitted work may still wait on the old acquire and present semaphores: let the device go
+    // idle before they are destroyed (Lichii #88).
+    if (swapchain) {
+        std::scoped_lock lock{scheduler.submit_mutex};
+        const VkResult result = device.GetLogical().WaitIdle();
+        if (result == VK_ERROR_DEVICE_LOST) {
+            device.ReportLoss();
+        }
+        vk::Check(result);
+    }
     Destroy();
 
     CreateSwapchain(capabilities);
@@ -178,6 +188,11 @@ bool Swapchain::AcquireNextImage(bool may_flush) {
         LOG_ERROR(Render_Vulkan, "vkAcquireNextImageKHR returned {}", string_VkResult(result));
         break;
     }
+    if (result == VK_ERROR_OUT_OF_DATE_KHR) {
+        // No image was acquired, so image_index is stale: the caller recreates and tries again
+        // (Lichii, upstream #427).
+        return true;
+    }
 
     const auto wait_with_frame_pacing = [this, may_flush] {
     switch (Settings::values.frame_pacing_mode.GetValue()) {
@@ -211,7 +226,9 @@ bool Swapchain::AcquireNextImage(bool may_flush) {
 
     resource_ticks[image_index] = scheduler.CurrentTick();
 
-    return is_suboptimal || is_outdated;
+    // A suboptimal acquire still acquired an image and signals its semaphore: present it, and let
+    // NeedsRecreation() recreate at the next frame (Lichii #88).
+    return false;
 }
 
 void Swapchain::Present(VkSemaphore render_semaphore) {
diff --git a/src/video_core/renderer_vulkan/vk_swapchain.h b/src/video_core/renderer_vulkan/vk_swapchain.h
--- a/src/video_core/renderer_vulkan/vk_swapchain.h
+++ b/src/video_core/renderer_vulkan/vk_swapchain.h
@@ -36,7 +36,8 @@ public:
         u32 width,
         u32 height);
 
-    /// Acquires the next image in the swapchain, waits as needed.
+    /// Acquires the next image in the swapchain, waits as needed. Returns true when no image was
+    /// acquired (out of date) and the swapchain has to be recreated first.
     /// `may_flush`: false on the async present thread (see Scheduler::Wait).
     bool AcquireNextImage(bool may_flush = true);
 
