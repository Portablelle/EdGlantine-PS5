 namespace {
+u32 NativeVideoConvertThreads() {
+    const char* setting = std::getenv("EDEN_NX2_VIDEO_CONVERT_THREADS");
+    if (!setting) return 4;
+    char* end;
+    const long value = std::strtol(setting, &end, 10);
+    if (end == setting || *end != '\0') return 4;
+    return static_cast<u32>(std::clamp(value, 1L, 8L));
+}
+
+// Owned by one codec and called synchronously by PumpOutput. Only CPU row
+// conversion runs on the workers; all guest memory and GPU operations stay here.
+class NativeVideoConverter {
+public:
+    void Convert(u8* rgba, u32 row_bytes, std::array<const u8*, 3> planes,
+                 std::array<u32, 3> strides, u32 width, u32 height, bool full_range) {
+        const auto convert_rows = [=](u32 first, u32 last) {
+            for (u32 y = first; y < last; ++y) {
+                ConvertNativeVideoYuv709Row(rgba + size_t{y} * row_bytes,
+                    planes[0] + size_t{y} * strides[0],
+                    planes[1] + size_t{y / 2} * strides[1],
+                    planes[2] + size_t{y / 2} * strides[2], width, full_range);
+            }
+        };
+        if (thread_count == 1 || height < 64 || size_t{width} * height < 65536) {
+            convert_rows(0, height);
+            return;
+        }
+        if (!workers) {
+            // The calling service thread converts one slice as well.
+            workers = std::make_unique<Common::ThreadWorker>(thread_count - 1, "VideoConvert");
+        }
+        // Also drain any queued slices if queue allocation throws. No task may
+        // outlive the caller's frame buffers, including during Stop/Reset.
+        SCOPE_EXIT { workers->WaitForRequests(); };
+        for (u32 i = 1; i < thread_count; ++i) {
+            const auto first = static_cast<u32>(u64{height} * i / thread_count);
+            const auto last = static_cast<u32>(u64{height} * (i + 1) / thread_count);
+            workers->QueueWork([=] { convert_rows(first, last); });
+        }
+        convert_rows(0, height / thread_count);
+    }
+
+private:
+    // Read once per codec. A single-threaded or small-frame codec creates no pool.
+    const u32 thread_count = NativeVideoConvertThreads();
+    std::unique_ptr<Common::ThreadWorker> workers;
+};
