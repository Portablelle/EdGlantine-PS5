Ported from open Lichii PR #185 (https://github.com/zortos293/Lichii/pull/185): land a parked
deferred clear before a blit, image copy or DMA write to the image (OoT terrain layer over the
scene, Lichii issue #101).

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index 0f8e395..a7ad1d1 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -1170,6 +1170,12 @@ bool TextureCache<P>::BlitImage(const Tegra::Engines::Fermi2D::Surface& dst,
     if (!result) {
         return false;
     }
+    // A deferred clear parked before this copy lands before it (Lichii #185). Realized later, at
+    // the next render pass of its framebuffer, it wiped what the copy wrote: OoT clears its
+    // occlusion depth, blits the scene depth over it and reads it back while drawing the terrain
+    // layer, which then covered the scene. Only when the copy proceeds: a rejected blit writes
+    // nothing, and the clear stays a load-op of the next draw.
+    runtime.FlushDeferredClear();
     const BlitImages images = *result;
     const ImageId dst_id = images.dst_id;
     const ImageId src_id = images.src_id;
@@ -2819,6 +2825,10 @@ ImageId TextureCache<P>::FindDMAImage(const ImageInfo& info, GPUVAddr gpu_addr)
 template <class P>
 std::pair<u32, u32> TextureCache<P>::PrepareDmaImage(ImageId dst_id, GPUVAddr base_addr,
                                                      bool mark_as_modified) {
+    // As in BlitImage: land a parked deferred clear before a DMA write (reads write nothing).
+    if (mark_as_modified) {
+        runtime.FlushDeferredClear();
+    }
     const auto& image = slot_images[dst_id];
     const auto base = image.TryFindBase(base_addr);
     PrepareImage(dst_id, mark_as_modified, false);
@@ -3873,6 +3883,8 @@ void TextureCache<P>::CopyImage(ImageId dst_id, ImageId src_id, std::vector<Imag
         // same guest data, which is uploaded from guest memory instead.
         return;
     }
+    // As in BlitImage: land a parked deferred clear before the copy overwrites the image.
+    runtime.FlushDeferredClear();
     const bool is_rescaled = True(src.flags & ImageFlagBits::Rescaled);
     if (is_rescaled) {
         ASSERT(True(dst.flags & ImageFlagBits::Rescaled));
