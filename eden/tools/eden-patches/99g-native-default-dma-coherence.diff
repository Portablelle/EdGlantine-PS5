     ReadNativeDmaCommandSnapshot(memory, address, destination, bytes, safe || dirty);
     return dirty;
 }
+// Low GPU accuracy makes the default DMA policy optimistic. It must not
+// bypass GPU-produced command bytes. Explicit unsafe DMA retains its policy.
+template <class Memory>
+void ReadNativeDmaSoloSnapshot(Memory& memory, GPUVAddr address, void* destination,
+                                std::size_t bytes, bool coherent, bool default_dma) {
+    if (!coherent && default_dma) {
+        ReadOwnedNativeDmaSnapshot(memory, address, destination, bytes, false);
+    } else {
+        ReadNativeDmaCommandSnapshot(memory, address, destination, bytes, coherent);
+    }
+}
 } // namespace Tegra
