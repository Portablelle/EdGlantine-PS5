+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+#include "x8d24_conversion.glsl"
+
+layout(binding = 0) uniform sampler2D depth_texture;
+layout(location = 0) out vec4 color;
+
+void main() {
+    float depth = texelFetch(depth_texture, ivec2(gl_FragCoord.xy), 0).r;
+    color = unpackUnorm4x8(EncodeX8D24(depth));
+}
diff --git a/src/video_core/host_shaders/x8d24_conversion.glsl b/src/video_core/host_shaders/x8d24_conversion.glsl
new file mode 100644
--- /dev/null
+++ b/src/video_core/host_shaders/x8d24_conversion.glsl
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+float DecodeX8D24(float red, float green, float blue) {
+    uint depth = uint(round(red * 255.0f)) | (uint(round(green * 255.0f)) << 8) |
+                 (uint(round(blue * 255.0f)) << 16);
+    uint scaled = floatBitsToUint(float(depth) * (1.0f / 16777216.0f));
+    return uintBitsToFloat(scaled + uint(depth != 0u));
+}
+
+uint EncodeX8D24(float depth) {
+    return uint(round(depth * 16777215.0f));
+}
