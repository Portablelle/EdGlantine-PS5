diff --git a/src/video_core/buffer_cache/buffer_cache_base.h b/src/video_core/buffer_cache/buffer_cache_base.h
index 6aa8182..ae1943d 100644
--- a/src/video_core/buffer_cache/buffer_cache_base.h
+++ b/src/video_core/buffer_cache/buffer_cache_base.h
@@ -702,6 +702,21 @@ private:
     mutable ::Common::unordered_map<u64, MappedPrefix> mapped_prefixes;
     /// Bumped by UnmapGPUMemory (any thread), whenever a GPU page's mapping type changes.
     std::atomic<u64> mapping_generation{1};
+    /// StorageBufferBinding's answers (Lichii #175): every draw binds each storage buffer again,
+    /// and working one out takes the memory layout lock and walks the page table. An answer holds
+    /// for the same pointer, size word and kind of binding until a GPU mapping changes.
+    struct CachedStorageBinding {
+        size_t owner; ///< MemoryManager id + 1, 0 when empty
+        GPUVAddr gpu_addr;
+        u64 following_word;
+        u64 map_serial;
+        u64 generation;
+        u32 flags;
+        Binding binding;
+    };
+    static constexpr size_t StorageBindingWays = 4;
+    mutable std::array<std::array<CachedStorageBinding, StorageBindingWays>, 256>
+        storage_binding_cache{};
     std::vector<MultiRangeSegment> graphics_segments;
     std::vector<MultiRangeSegment> compute_segments;
     u64 frame_tick = 0;
diff --git a/src/video_core/memory_manager.cpp b/src/video_core/memory_manager.cpp
index e5d2559..a493cfc 100644
--- a/src/video_core/memory_manager.cpp
+++ b/src/video_core/memory_manager.cpp
@@ -549,7 +549,8 @@ bool MemoryManager::IsMemoryDirty(GPUVAddr gpu_addr, size_t size,
 size_t MemoryManager::MaxContinuousRange(GPUVAddr gpu_addr, size_t size) const {
     // Native storage buffers ask this for up to 8 MiB on each bind, ~70,000 times a second in
     // title 1's forest (17% of the GPU thread walking pages): keep answers per thread until the
-    // page table changes.
+    // page table changes. Four ways per set (Lichii #175): direct-mapped, conflicting ranges
+    // were still walked thousands of times a second.
     struct Entry {
         size_t owner;
         GPUVAddr gpu_addr;
@@ -557,15 +558,23 @@ size_t MemoryManager::MaxContinuousRange(GPUVAddr gpu_addr, size_t size) const {
         u64 serial;
         size_t result;
     };
-    thread_local std::array<Entry, 64> cache{};
+    constexpr size_t Ways = 4;
+    thread_local std::array<std::array<Entry, Ways>, 256> cache{};
     const u64 serial = map_serial.load(std::memory_order_acquire);
-    Entry& entry = cache[((gpu_addr ^ size) * 0x9E3779B97F4A7C15ULL) >> 58];
-    if (entry.owner == unique_identifier + 1 && entry.gpu_addr == gpu_addr && entry.size == size &&
-        entry.serial == serial) {
-        return entry.result;
+    auto& set = cache[((gpu_addr ^ size) * 0x9E3779B97F4A7C15ULL) >> 56];
+    for (size_t way = 0; way < Ways; ++way) {
+        const Entry& entry = set[way];
+        if (entry.owner == unique_identifier + 1 && entry.gpu_addr == gpu_addr &&
+            entry.size == size && entry.serial == serial) {
+            const size_t result = entry.result;
+            // Most recent answers first; the last way is the one replaced.
+            std::rotate(set.begin(), set.begin() + way, set.begin() + way + 1);
+            return result;
+        }
     }
     const size_t result = MaxContinuousRangeUncached(gpu_addr, size);
-    entry = {unique_identifier + 1, gpu_addr, size, serial, result};
+    std::rotate(set.begin(), set.end() - 1, set.end());
+    set[0] = {unique_identifier + 1, gpu_addr, size, serial, result};
     return result;
 }
 
diff --git a/src/video_core/memory_manager.h b/src/video_core/memory_manager.h
