Ported from open Lichii PR #175 (https://github.com/zortos293/Lichii/pull/175, by mja00): cache
storage buffer bindings. Every draw binds each storage buffer again, and working one out takes the
memory layout lock and walks the page table. BufferCache::StorageBufferBinding now keeps its answers
in a small 4-way cache, keyed by memory manager, pointer, size word and kind of binding, and valid
until a GPU mapping changes (MemoryManager::MapSerial and the buffer cache mapping generation). The
continuous-range cache from 99zy also becomes 4-way, as in the PR. Reimplemented on our
StorageBufferBinding (StorageBufferSize, MappedStoragePrefix), not copied.


diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index b9afde7..6dc7ae9 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -2618,8 +2618,31 @@ Binding BufferCache<P>::StorageBufferBinding(GPUVAddr ssbo_addr, u32 cbuf_index,
                     gpu_memory->GetMemoryLayoutSize(gpu_addr), is_written, native_pointer, cbuf_index,
                     ssbo_addr);
 
-    const u64 mapped_size = gpu_memory->GetMemoryLayoutSize(gpu_addr);
     const u64 following_word = native_pointer ? 0 : gpu_memory->Read<u64>(ssbo_addr + 8);
+    // Read both before the lookup: a mapping change during it leaves the entry stale, not wrong.
+    const size_t owner = gpu_memory->GetID() + 1;
+    const u64 map_serial = gpu_memory->MapSerial();
+    const u64 generation = mapping_generation.load(std::memory_order_acquire);
+    const u32 flags = (is_written ? 1U : 0U) | (native_pointer ? 2U : 0U);
+    auto& cache_set = storage_binding_cache[((gpu_addr ^ following_word ^ flags) *
+                                             0x9E3779B97F4A7C15ULL) >> 56];
+    for (size_t way = 0; way < StorageBindingWays; ++way) {
+        const CachedStorageBinding& cached = cache_set[way];
+        if (cached.owner == owner && cached.gpu_addr == gpu_addr &&
+            cached.following_word == following_word && cached.flags == flags &&
+            cached.map_serial == map_serial && cached.generation == generation) {
+            const Binding hit = cached.binding;
+            std::rotate(cache_set.begin(), cache_set.begin() + way, cache_set.begin() + way + 1);
+            return hit;
+        }
+    }
+    const auto remember = [&](const Binding& result) {
+        std::rotate(cache_set.begin(), cache_set.end() - 1, cache_set.end());
+        cache_set[0] = {owner, gpu_addr, following_word, map_serial, generation, flags, result};
+        return result;
+    };
+
+    const u64 mapped_size = gpu_memory->GetMemoryLayoutSize(gpu_addr);
     u32 size = StorageBufferSize(mapped_size, following_word, native_pointer);
     if (native_pointer && size) {
         size = MappedStoragePrefix(gpu_addr, size);
@@ -2633,7 +2656,7 @@ Binding BufferCache<P>::StorageBufferBinding(GPUVAddr ssbo_addr, u32 cbuf_index,
     const std::optional<DAddr> aligned_device_addr = gpu_memory->GpuToCpuAddress(aligned_gpu_addr);
     if (!aligned_device_addr || size == 0) {
         LOG_DEBUG(HW_GPU, "Failed to find storage buffer for cbuf index {}", cbuf_index);
-        return NULL_BINDING;
+        return remember(NULL_BINDING);
     }
     const std::optional<DAddr> device_addr = gpu_memory->GpuToCpuAddress(gpu_addr);
     ASSERT_MSG(device_addr, "Unaligned storage buffer address not found for cbuf index {}",
@@ -2651,7 +2674,7 @@ Binding BufferCache<P>::StorageBufferBinding(GPUVAddr ssbo_addr, u32 cbuf_index,
         .size = binding_size,
         .buffer_id = BufferId{},
     };
-    return binding;
+    return remember(binding);
 }
 
