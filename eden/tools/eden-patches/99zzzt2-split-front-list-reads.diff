+// Front-side write tracking for command list segments (GPU thread split, mode 1).
+// Ideas from Lichii (github.com/zortos293/Lichii) PRs #179 (EDEN_NX2_LIST_FAST: skip the wait
+// for queued writers once no page has been newly GPU-written for a while, checked on the back)
+// and #243 (front reads that wait only for the writes that can matter). Written for this core.
+//
+// Each segment used to wait for the back (GpuSplit::Synchronize): the back checked whether its
+// caches held GPU writes to the segment, then copied it. Now the front copies it from guest
+// memory itself when:
+//  - reads are unsafe and the entry has no sync flag (the flag is how the GPU orders a command
+//    fetch after earlier work; such entries still wait);
+//  - every 4 KiB page of the segment is mapped and none of them was ever GPU-written
+//    (gpu_written_pages.h);
+//  - no page anywhere was newly GPU-written in the last second, so the set of written pages is
+//    settled (a queued draw or copy writing a command page for the first time is the case the
+//    bitmap cannot see yet);
+//  - the segment is at most 64 KiB.
+// Otherwise it waits as before. Every early read is checked on the back, in order, where the
+// wait used to be: if the old path would have read other bytes there (dirty caches, or other
+// guest memory contents), it logs NX2_SPLIT_TRACK_MISS and turns the early reads off for the
+// rest of the run.
+constexpr size_t MaxFrontSegmentBytes = 64 * 1024;
+constexpr auto SettleTime = std::chrono::seconds{1};
+
+struct FrontListState {
+    u64 marks = ~u64{0};
+    std::chrono::steady_clock::time_point marks_changed{};
+};
+FrontListState front_list_state; // front thread only
+
+struct FrontSegmentCheck {
+    MemoryManager* memory;
+    GPUVAddr address;
+    u32* front_words;
+    size_t bytes;
+
+    void operator()() const {
+        using Split = VideoCommon::SplitPerformance;
+        const bool dirty = memory->IsMemoryDirty(address, bytes);
+        bool same = false;
+        if (!dirty) {
+            static std::vector<u32> back_words; // back thread only
+            back_words.resize(bytes / sizeof(u32));
+            memory->ReadBlockUnsafe(address, back_words.data(), bytes);
+            same = std::memcmp(back_words.data(), front_words, bytes) == 0;
+        }
+        auto& observation = VideoCommon::NativeSemaphoreObservation::state;
+        if (observation.enabled.load(std::memory_order_relaxed)) {
+            ++observation.header_reads;
+            observation.header_bytes.fetch_add(bytes);
+            if (dirty) ++observation.header_dirty;
+        }
+        ++Split::list_verified;
+        if (dirty || !same) {
+            const auto misses = ++Split::list_misses;
+            VideoCommon::SplitTracking::disabled.store(true, std::memory_order_release);
+            if (misses <= 16) {
+                std::fprintf(stderr, "NX2_SPLIT_TRACK_MISS gpu=%llx bytes=%llu dirty=%d\n",
+                             static_cast<unsigned long long>(address),
+                             static_cast<unsigned long long>(bytes), dirty ? 1 : 0);
+            }
+        }
+        delete[] front_words;
+    }
+};
