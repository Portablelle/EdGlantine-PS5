+/// Front: copies the segment into `destination` without waiting for the back, when nothing
+/// queued or cached can have written it (see above). False: the caller waits as before.
+bool ReadSegmentOnFront(MemoryManager& memory, const CommandListHeader& header,
+                        void* destination, size_t bytes, bool use_safe) {
+    using Split = VideoCommon::SplitPerformance;
+    namespace Pages = VideoCommon::GpuWrittenPages;
+    if (VideoCommon::SplitTracking::disabled.load(std::memory_order_acquire)) {
+        ++Split::list_fb_off;
+        return false;
+    }
+    if (use_safe || header.sync.Value() != 0 || bytes == 0 || bytes > MaxFrontSegmentBytes) {
+        ++Split::list_fb_other;
+        return false;
+    }
+    const u64 marks = Pages::new_marks.load(std::memory_order_acquire);
+    const auto now = std::chrono::steady_clock::now();
+    if (marks != front_list_state.marks) {
+        front_list_state.marks = marks;
+        front_list_state.marks_changed = now;
+        ++Split::list_fb_settle;
+        return false;
+    }
+    if (now - front_list_state.marks_changed < SettleTime) {
+        ++Split::list_fb_settle;
+        return false;
+    }
+    const GPUVAddr address = header.addr;
+    for (GPUVAddr page = address & ~GPUVAddr{0xfff}; page < address + bytes; page += 0x1000) {
+        const auto device = memory.GpuToCpuAddress(page);
+        if (!device) {
+            ++Split::list_fb_other;
+            return false;
+        }
+        if (Pages::Any(*device, 1)) {
+            ++Split::list_fb_written;
+            return false;
+        }
+    }
+    memory.ReadBlockUnsafe(address, destination, bytes);
+    auto* const front_words = new u32[bytes / sizeof(u32)];
+    std::memcpy(front_words, destination, bytes);
+    VideoCommon::GpuSplit::Get().Defer(FrontSegmentCheck{&memory, address, front_words, bytes});
+    ++Split::list_direct;
+    return true;
+}
