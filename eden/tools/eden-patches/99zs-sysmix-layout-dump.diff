     // is empty are dropped, as an underrun plays silence), and signals the data event of every open
     // stream with at least its threshold of free frames, engaged or not: the game fills the ring
     // before it engages the stream.
+    static void DumpLayout(Core::Memory::Memory& memory, Nx2SysmixStream& stream, u32 read, u32 write) {
+        const std::size_t bytes = static_cast<std::size_t>((std::min<u64>)(stream.size, 0x40000));
+        std::vector<u8> data(bytes);
+        memory.ReadBlock(stream.buffer, data.data(), bytes);
+        std::size_t nonzero_rows = 0, first = bytes, last = 0;
+        for (std::size_t row = 0; row + 16 <= bytes; row += 16) {
+            if (std::any_of(data.begin() + row, data.begin() + row + 16, [](u8 b) { return b != 0; })) {
+                ++nonzero_rows;
+                first = (std::min)(first, row);
+                last = row;
+            }
+        }
+        LOG_INFO(Service_Audio,
+                 "EDEN_SYSMIX_LAYOUT stream={} dump={} buffer={:#x} size={:#x} type={} channels={} rate={} "
+                 "frames={} read={} write={} nonzero_rows={} first={:#x} last={:#x}",
+                 stream.id, stream.layout_dumps, stream.buffer, stream.size, stream.sample_type,
+                 stream.channels, stream.sample_rate, stream.frames, read, write, nonzero_rows, first, last);
+        std::size_t shown = 0;
+        for (std::size_t row = 0; row + 16 <= bytes && shown < 80; row += 16) {
+            const bool header = row < 0x60 || (row >= 0xff0 && row < 0x1060);
+            const bool nonzero =
+                std::any_of(data.begin() + row, data.begin() + row + 16, [](u8 b) { return b != 0; });
+            if (!header && !nonzero) {
+                continue;
+            }
+            // Past the header, every 16th non-zero row, so the samples' extent shows.
+            if (!header && (row / 16) % 16 != 0) {
+                continue;
+            }
+            u32 w[4];
+            std::memcpy(w, data.data() + row, sizeof(w));
+            LOG_INFO(Service_Audio, "EDEN_SYSMIX_ROW stream={} off={:#06x} {:08x} {:08x} {:08x} {:08x}",
+                     stream.id, row, w[0], w[1], w[2], w[3]);
+            ++shown;
+        }
+        ++stream.layout_dumps;
+    }
