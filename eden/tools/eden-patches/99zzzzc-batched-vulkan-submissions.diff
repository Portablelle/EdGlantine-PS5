+                        std::chrono::duration_cast<std::chrono::seconds>(now - start).count(),
+                        tick);
+            split.RequestSubmitHook();
+        }
+        if (spins < 64) {
+            std::this_thread::yield();
+        } else {
+            std::this_thread::sleep_for(std::chrono::microseconds{50});
+        }
+    }
