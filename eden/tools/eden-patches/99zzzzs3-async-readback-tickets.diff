 template <class P>
+u64 BufferCache<P>::DownloadMemoryForRead(DAddr device_addr, u64 size) {
+#ifdef EDEN_NX2_PS5_PROTO
+    if constexpr (USE_MEMORY_MAPS && requires { runtime.CurrentTick(); runtime.Wait(u64{}); }) {
+        // One read download at a time; parameter readbacks keep their window cache.
+        if (!read_download.active && !IsParameterReadback(device_addr, size)) {
+            read_download.active = true;
+            bool recorded = false;
+            SCOPE_EXIT {
+                if (!recorded) {
+                    CancelReadDownload();
+                }
+            };
+            boost::container::small_vector<std::pair<BufferId, BufferCopy>, 4> copies;
+            u64 total_size_bytes = 0;
+            // The ranges DownloadBufferMemory's precise path copies, cleared the same way except
+            // that they stay GPU-modified until FinishReadDownload.
+            ForEachBufferInRange(device_addr, size, [&](BufferId buffer_id, Buffer& buffer) {
+                const DAddr begin = std::max(device_addr, buffer.CpuAddr());
+                const DAddr end = std::min(device_addr + size, buffer.CpuAddr() + buffer.SizeBytes());
+                if (end <= begin) {
+                    return;
+                }
+                read_download.requests.emplace_back(begin, end - begin);
+                memory_tracker.ForEachDownloadRange(
+                    begin, end - begin, false, [&](u64 range_addr, u64 range_size) {
+                        const DAddr range_end = std::min(range_addr + range_size, end);
+                        range_addr = std::max(range_addr, begin);
+                        range_size = range_end - range_addr;
+                        gpu_modified_ranges.ForEachInRange(
+                            range_addr, range_size, [&](DAddr start, DAddr stop) {
+                                copies.push_back({buffer_id, BufferCopy{
+                                                                 .src_offset = start - buffer.CpuAddr(),
+                                                                 .dst_offset = total_size_bytes,
+                                                                 .size = stop - start,
+                                                             }});
+                                total_size_bytes += Common::AlignUp(stop - start, 64);
+                            });
+                        ClearDownload(range_addr, range_size);
+                        read_download.downloaded.emplace_back(range_addr, range_size);
+                    });
+            });
+            if (total_size_bytes == 0) {
+                recorded = true;
+                FinishReadDownload();
+                return 0;
+            }
+            auto staging = runtime.DownloadStagingBuffer(total_size_bytes);
+            read_download.staging = staging.mapped_span.data();
+            for (size_t first = 0; first < copies.size();) {
+                const BufferId buffer_id = copies[first].first;
+                boost::container::small_vector<BufferCopy, 4> buffer_copies;
+                Buffer& buffer = slot_buffers[buffer_id];
+                for (; first < copies.size() && copies[first].first == buffer_id; ++first) {
+                    BufferCopy copy = copies[first].second;
+                    read_download.copies.push_back(
+                        {buffer.CpuAddr() + copy.src_offset, copy.size, copy.dst_offset});
+                    copy.dst_offset += staging.offset;
+                    buffer.MarkUsage(copy.src_offset, copy.size);
+                    buffer_copies.push_back(copy);
+                }
+                runtime.CopyBuffer(staging.buffer, buffer,
+                                   std::span<const BufferCopy>(buffer_copies.data(), buffer_copies.size()),
+                                   true);
+            }
+            recorded = true;
+            return runtime.CurrentTick();
+        }
+    }
+#endif
+    DownloadMemory(device_addr, size);
+    return 0;
+}
+
+template <class P>
+void BufferCache<P>::WaitReadDownload(u64 tick) {
+    // Only DownloadMemoryForRead's ticks reach here, and only runtimes with Wait make them.
+    if constexpr (requires { runtime.Wait(u64{}); }) {
+        runtime.Wait(tick);
+    }
+}
+
+template <class P>
+void BufferCache<P>::FinishReadDownload() {
+    if (!read_download.active) {
+        return;
+    }
+    for (const auto& copy : read_download.copies) {
+        // Bytes that stopped being GPU-modified since the copy was recorded (WriteMemory) hold
+        // newer values. CPU writes into the copies wait for this (RasterizerVulkan::OnCPUWrite).
+        gpu_modified_ranges.ForEachInRange(copy.device_addr, copy.size, [&](DAddr start, DAddr end) {
+            device_memory.WriteBlockUnsafe(
+                start, read_download.staging + copy.staging_offset + (start - copy.device_addr),
+                end - start);
+        });
+    }
+    for (const auto& [range_addr, range_size] : read_download.downloaded) {
+        gpu_modified_ranges.Subtract(range_addr, range_size);
+    }
+    for (const auto& [range_addr, range_size] : read_download.requests) {
+        // As DownloadBufferMemory: page bits stay for GPU bytes outside what was downloaded.
+        const DAddr page_start = Common::AlignDown(range_addr, DEVICE_PAGESIZE);
+        const DAddr page_end = Common::AlignUp(range_addr + range_size, DEVICE_PAGESIZE);
+        memory_tracker.UnmarkRegionAsGpuModified(range_addr, range_size);
+        gpu_modified_ranges.ForEachInRange(page_start, page_end - page_start,
+                                           [&](DAddr start, DAddr end) {
+                                               memory_tracker.MarkRegionAsGpuModified(start, end - start);
+                                           });
+    }
+    CancelReadDownload();
+}
+
+template <class P>
+void BufferCache<P>::CancelReadDownload() {
+    read_download.copies.clear();
+    read_download.downloaded.clear();
+    read_download.requests.clear();
+    read_download.staging = nullptr;
+    read_download.active = false;
+}
+
+template <class P>
 void BufferCache<P>::SynchronizeStoragePointer(GPUVAddr pointer_address) {
     if (const auto device_addr = gpu_memory->GpuToCpuAddress(pointer_address);
         device_addr && IsRegionGpuModified(*device_addr, sizeof(u64))) {
         DownloadMemory(*device_addr, sizeof(u64));
     }
 }
