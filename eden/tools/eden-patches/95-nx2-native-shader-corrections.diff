 // native bytes. Scheduling/control words are added by the environment adapter.
+// A canceled inner PBK may be discarded by the immediately enclosing SSY.
+// Prove the selected path skips the inner join and reaches the parent's join
+// using only register cleanup and unconditional forward branches. This also
+// handles BREAK/BRA with both an execution and a second condition predicate.
+inline bool VerifiedParentCancellation(std::span<const Instruction> code, u32 at,
+                                       u32 inner_at, u32 parent_at) {
+    if (at >= code.size() || code.size() - at < 2 ||
+        inner_at >= code.size() || parent_at >= code.size()) return false;
+    const auto& cancel = code[at];
+    const auto& branch = code[at + 1];
+    const auto& inner = code[inner_at];
+    const auto& parent = code[parent_at];
+    const auto target = [](const Instruction& instruction, u32 pc) {
+        const u64 raw = instruction.words[1] | (u64{instruction.words[2] & 0x3ffff} << 32);
+        return s64{pc + 1} * 16 + (static_cast<s64>(raw << 14) >> 14);
+    };
+    if (cancel.Bits(0, 12) != 0x942 || cancel.words[1] ||
+        (cancel.words[0] & ~0x0000f000U) != (0x942U | (inner.Bits(16, 4) << 16)) ||
+        (cancel.words[2] & ~0x07800000U) ||
+        branch.words[0] != (0x947U | (cancel.Bits(12, 4) << 12)) ||
+        (branch.words[2] & ~0x3ffffU) != cancel.words[2]) return false;
+    const s64 inner_end = s64{inner_at + 1} * 16 + static_cast<s32>(inner.words[1]);
+    const s64 join = s64{parent_at} * 16 + static_cast<s32>(parent.words[1]);
+    s64 pc = target(branch, at + 1);
+    if (pc < 0 || inner_end < 0 || pc < inner_end || pc > join || pc % 16 || join < 0 || join % 16 ||
+        static_cast<u64>(join / 16) >= code.size()) return false;
+    const auto& sync = code[join / 16];
+    if (sync.words[0] != (0x7941U | (parent.Bits(16, 4) << 16)) ||
+        sync.words[1] || sync.words[2] != 0x03800000U) return false;
+    while (pc < join) {
+        const auto& instruction = code[pc / 16];
+        const u32 op = instruction.Bits(0, 12);
+        if (op == 0x947) {
+            if (instruction.words[0] != 0x7947U ||
+                (instruction.words[2] & ~0x3ffffU) != 0x03800000U) return false;
+            const s64 next = target(instruction, static_cast<u32>(pc / 16));
+            if (next <= pc || next > join || next % 16) return false;
+            pc = next;
+        } else {
+            if (op != 0x202 && op != 0x802 && op != 0xa02 &&
+                op != 0x224 && op != 0x824 && op != 0xa24 && op != 0x918) return false;
+            pc += 16;
+        }
+    }
+    return true;
+}
