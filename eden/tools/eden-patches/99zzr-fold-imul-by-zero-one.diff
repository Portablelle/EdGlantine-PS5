+/// Folds products by 0 and 1 (Lichii #150). An XMAD multiplication by a 16-bit immediate leaves
+/// them behind (the cross term of the high halves), and OoT's IMAD.WIDE pointer + offset then hid
+/// the pointer from storage buffer tracking, which bound the offset word as the buffer instead.
+void FoldIMul32(IR::Inst& inst) {
+    if (FoldWhenAllImmediates(inst, [](u32 a, u32 b) { return a * b; })) {
+        return;
+    }
+    for (size_t arg = 0; arg < 2; ++arg) {
+        const IR::Value factor{inst.Arg(arg)};
+        if (!factor.IsImmediate()) {
+            continue;
+        }
+        if (factor.U32() == 0) {
+            inst.ReplaceUsesWith(IR::Value{0U});
+            return;
+        }
+        if (factor.U32() == 1) {
+            const IR::Value other{inst.Arg(1 - arg)};
+            inst.ReplaceUsesWith(other);
+            return;
+        }
+    }
+}
