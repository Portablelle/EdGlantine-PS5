+template <class P>
+bool TextureCache<P>::AddSparseDirtyRange(ImageBase& image, u64 begin, u64 end) {
+    auto& ranges = image.partial_remapped;
+    auto first = std::lower_bound(ranges.begin(), ranges.end(), begin,
+        [](const auto& range, u64 value) { return range.second < value; });
+    auto last = first;
+    while (last != ranges.end() && last->first <= end) {
+        begin = (std::min)(begin, last->first);
+        end = (std::max)(end, last->second);
+        ++last;
+    }
+    const auto index = ranges.erase(first, last) - ranges.begin();
+    ranges.insert(ranges.begin() + index, {begin, end});
+    u64 bytes = 0;
+    for (const auto& range : ranges) bytes += range.second - range.first;
+    if (bytes > image.guest_size_bytes / 4 || ranges.size() > 4096) {
+        ranges.clear(); // A bounded full refresh; subsequent writes must not narrow it.
+        return false;
+    }
+    return true;
+}
