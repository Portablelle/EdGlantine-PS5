+template <class P>
+void TextureCache<P>::RebuildSparseMappings(ImageId image_id, Image& image) {
+    // Called after mapping notifications, before all PrepareImage paths including
+    // full render-target clears. Preserve GPU indices, LRU, allocation and budget.
+    auto& maps = sparse_views.at(image_id);
+    // Old map IDs and physical pages must still exist when restoring their refs.
+    auto pending_ranges = std::move(image.partial_remapped);
+    RestorePartialPages(image);
+    image.partial_remapped = std::move(pending_ranges);
+    const bool tracked = True(image.flags & ImageFlagBits::Tracked);
+    for (const auto map_id : maps) {
+        const auto& map = slot_map_views[map_id];
+        if (tracked) device_memory.UpdatePagesCachedCount(map.cpu_addr, map.size, -1);
+        ForEachCPUPage(map.cpu_addr, map.size, [this, map_id](u64 page) {
+            auto& views = page_table.at(page);
+            const auto it = std::ranges::find(views, map_id);
+            ASSERT(it != views.end());
+            views.erase(it);
+        });
+        slot_map_views.erase(map_id);
+    }
+    maps.clear();
+    ForEachSparseSegment(image, [this, image_id, &maps, tracked](GPUVAddr gpu_addr, DAddr cpu_addr, size_t size) {
+        const auto map_id = slot_map_views.insert(gpu_addr, cpu_addr, size, image_id);
+        ForEachCPUPage(cpu_addr, size, [this, map_id](u64 page) { page_table[page].push_back(map_id); });
+        maps.push_back(map_id);
+        if (tracked) device_memory.UpdatePagesCachedCount(cpu_addr, size, 1);
+    });
+    image.sparse_mappings_changed = false;
+}
