+template <class P>
+bool TextureCache<P>::MarkSparseWrite(ImageId image_id, Image& image, DAddr cpu_addr, size_t size) {
+    if (!CanUploadSparsePartial(image) || False(image.flags & ImageFlagBits::Tracked)) return false;
+    if (True(image.flags & ImageFlagBits::CpuModified) && image.partial_remapped.empty()) {
+        UntrackImage(image, image_id);
+        return true;
+    }
+    // Map views, rather than image.cpu_addr, describe discontinuous and aliased
+    // guest memory. Remove each physical-page reference once, including aliases.
+    for (const auto map_id : sparse_views.at(image_id)) {
+        const auto& map = slot_map_views[map_id];
+        const DAddr begin = (std::max)(cpu_addr, map.cpu_addr);
+        if (begin - cpu_addr >= size || begin - map.cpu_addr >= map.size) continue;
+        const u64 length = (std::min<u64>)(size - (begin - cpu_addr), map.size - (begin - map.cpu_addr));
+        const DAddr first_page = begin & ~DAddr{Core::DEVICE_PAGEMASK};
+        const DAddr last_page = (begin + length - 1) & ~DAddr{Core::DEVICE_PAGEMASK};
+        // Once a physical page is untracked, later writes anywhere in that page
+        // need not notify us. Upload the entire intersection with this map view.
+        const DAddr dirty_begin = (std::max)(first_page, map.cpu_addr);
+        const DAddr dirty_end = (std::min)(last_page + Core::DEVICE_PAGESIZE, map.cpu_addr + map.size);
+        const u64 offset = map.gpu_addr - image.gpu_addr + dirty_begin - map.cpu_addr;
+        if (!AddSparseDirtyRange(image, offset, offset + dirty_end - dirty_begin)) {
+            UntrackImage(image, image_id);
+            break;
+        }
+        for (DAddr page = first_page;; page += Core::DEVICE_PAGESIZE) {
+            const auto key = std::pair{page, map_id.index};
+            auto it = std::lower_bound(image.sparse_dirty_pages.begin(), image.sparse_dirty_pages.end(), key);
+            if (it == image.sparse_dirty_pages.end() || *it != key) {
+                image.sparse_dirty_pages.insert(it, key);
+                device_memory.UpdatePagesCachedCount(page, Core::DEVICE_PAGESIZE, -1);
+            }
+            if (page == last_page) break;
+        }
+    }
+    image.flags |= ImageFlagBits::CpuModified;
+    return true;
+}
