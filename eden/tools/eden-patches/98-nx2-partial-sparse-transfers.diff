 template <class P>
+bool TextureCache<P>::CanUploadSparsePartial(const ImageBase& image) const {
+    // Adapted from Eglantine's large single-layer SparseTiles path. Host images
+    // stay fully allocated: no unbound sampling or sparseResidencyAliased needed.
+    constexpr auto excluded = ImageFlagBits::Converted | ImageFlagBits::AcceleratedUpload |
+        ImageFlagBits::Unbacked | ImageFlagBits::TrimmedLevels |
+        ImageFlagBits::AsynchronousDecode | ImageFlagBits::Rescaled |
+        ImageFlagBits::Remapped | ImageFlagBits::GpuModified;
+    return True(image.flags & ImageFlagBits::Sparse) && False(image.flags & excluded) &&
+        !image.HasScaled() && image.guest_size_bytes >= 32_MiB &&
+        image.info.type == ImageType::e2D && image.info.resources.layers == 1 &&
+        image.info.size.depth == 1 && image.info.block.depth == 0 &&
+        image.info.num_samples == 1 &&
+        GetFormatType(image.info.format) == SurfaceType::ColorTexture &&
+        DefaultBlockWidth(image.info.format) == 1 && DefaultBlockHeight(image.info.format) == 1;
+}
