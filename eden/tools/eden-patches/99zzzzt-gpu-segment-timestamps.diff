+// SPDX-License-Identifier: GPL-3.0-or-later
+// Scheduler-owned guest query pools, independent of the opt-in profiling pools.
+struct Scheduler::GuestTimestampState {
+    static constexpr u32 Capacity = 4096;
+    struct Buffer {
+        vk::QueryPool pool;
+        Tegra::SegmentClock clock;
+        u64 tick{}, anchor_ns{};
+        u32 count = 2;
+        std::vector<u64> results;
+        bool collected{};
+    };
+    struct Ticket {
+        std::shared_ptr<Buffer> buffer;
+        u32 slot{};
+        u64 epoch{};
+    };
+    std::mutex mutex;
+    std::deque<std::shared_ptr<Buffer>> pending;
+    std::shared_ptr<Buffer> current;
+    PFN_vkCmdWriteTimestamp write{};
+    double period{};
+    u32 bits{};
+    u64 epoch{};
+    std::shared_ptr<u64> published = std::make_shared<u64>(0);
+};
+
+void Scheduler::BeginGuestTimestamps() {
+    auto& s = *guest_timestamps;
+    std::scoped_lock lock{s.mutex};
+    s.current.reset();
+    // A ticket owns its epoch's pool until publication. Never recycle live or pending queries.
+    vk::QueryPool recycled;
+    std::erase_if(s.pending, [this, &recycled](const auto& b) {
+        if (b.use_count() != 1 || !b->tick || !IsFree(b->tick)) return false;
+        if (!recycled) recycled = std::move(b->pool);
+        return true;
+    });
+    if (s.pending.size() >= 64) return; // bounded pressure fallback, no fence wait
+    if (!s.write) {
+        s.write = reinterpret_cast<PFN_vkCmdWriteTimestamp>(device.GetDispatchLoader().vkGetDeviceProcAddr(
+            *device.GetLogical(), "vkCmdWriteTimestamp"));
+        s.period = device.GetPhysical().GetProperties().limits.timestampPeriod;
+        s.bits = device.GetPhysical().GetQueueFamilyProperties()[device.GetGraphicsFamily()].timestampValidBits;
+    }
+    if (!s.write || !s.bits || s.period <= 0) return;
+    auto b = std::make_shared<GuestTimestampState::Buffer>();
+    b->pool = recycled ? std::move(recycled) : device.GetLogical().CreateQueryPool({
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .pNext = nullptr, .flags = 0, .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = GuestTimestampState::Capacity, .pipelineStatistics = 0,
+    });
+    b->clock.epoch = ++s.epoch;
+    b->clock.segments.resize(1);
+    current_cmdbuf.ResetQueryPool(*b->pool, 0, GuestTimestampState::Capacity);
+    s.write(*current_cmdbuf, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, *b->pool, 0);
+    s.pending.push_back(b);
+    s.current = std::move(b);
+}
+
+void Scheduler::EndGuestTimestamps(vk::CommandBuffer cmdbuf, u64 tick) {
+    auto& s = *guest_timestamps;
+    std::scoped_lock lock{s.mutex};
+    if (!s.current) return;
+    s.write(*cmdbuf, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *s.current->pool, 1);
+    s.current->tick = tick;
+    s.current->clock.commits.push_back(0); // this scheduler submission commits one CB
+}
+
+Tegra::ReportTimestamp Scheduler::CaptureGuestTimestamp(u64 guest_ns) {
+    auto ticket = std::make_shared<GuestTimestampState::Ticket>();
+    std::shared_ptr<u64> published;
+    {
+        std::scoped_lock lock{guest_timestamps->mutex};
+        published = guest_timestamps->published;
+    }
+    Record([this, ticket, guest_ns](vk::CommandBuffer cmdbuf) {
+        auto& s = *guest_timestamps;
+        std::scoped_lock lock{s.mutex};
+        auto b = s.current;
+        if (!b) return;
+        ticket->buffer = b;
+        ticket->epoch = b->clock.epoch;
+        if (b->count == GuestTimestampState::Capacity) return;
+        ticket->slot = b->count++;
+        if (!b->anchor_ns) b->anchor_ns = guest_ns;
+        // Timestamp writes are allowed inside a render pass. Pool reset is at CB begin only.
+        s.write(*cmdbuf, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, *b->pool, ticket->slot);
+    });
+    return [this, ticket, published](u64 fallback, const Tegra::TimestampConvert& convert) {
+        auto& s = *guest_timestamps;
+        std::scoped_lock lock{s.mutex};
+        const auto monotonic = [&](u64 ns) {
+            *published = std::max(*published, ns);
+            return *published;
+        };
+        auto b = ticket->buffer;
+        if (!b || ticket->epoch != b->clock.epoch || !b->tick || !IsFree(b->tick)) return monotonic(fallback);
+        if (!b->collected) {
+            b->results.resize(b->count);
+            if (device.GetLogical().GetQueryResults(*b->pool, 0, b->count,
+                    b->results.size() * sizeof(u64), b->results.data(), sizeof(u64),
+                    VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) return monotonic(fallback);
+            // Pair the first encoded report's guest sample with its GPU stamp. This is an
+            // offset mapping, not a publish-time CPU sample; all report spans use GPU time.
+            const u64 age = Tegra::SegmentClock::DeltaNs(b->results[2], b->results[0], s.bits, s.period);
+            b->clock.begin = b->anchor_ns > age ? b->anchor_ns - age : 1;
+            b->clock.segments[0].start = b->clock.begin;
+            b->clock.segments[0].end = b->clock.begin + Tegra::SegmentClock::DeltaNs(
+                b->results[1], b->results[0], s.bits, s.period);
+            b->collected = true;
+        }
+        const u64 ns = ticket->slot ? b->clock.begin + Tegra::SegmentClock::DeltaNs(
+            b->results[ticket->slot], b->results[0], s.bits, s.period) : 0;
+        return monotonic(b->clock.ReportTicks(0, false, {ns, ticket->epoch},
+                b->clock.segments[0].start, b->clock.segments[0].end, fallback, convert));
+    };
+}
