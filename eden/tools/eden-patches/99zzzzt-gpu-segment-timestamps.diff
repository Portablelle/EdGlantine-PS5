+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <functional>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Tegra {
+
+// Guest nanoseconds throughout. Zero means unavailable, never a reason to wait.
+struct SegmentClock {
+    struct Segment { u64 start{}, end{}; };
+    struct Stamp { u64 ns{}, epoch{}; };
+    std::vector<Segment> segments;
+    std::vector<size_t> commits;
+    u64 begin{}, epoch{}, published{};
+
+    u64 IdleBefore(u64 ns, u64 c0) const {
+        u64 idle = 0;
+        for (size_t i = 0; i < commits.size(); ++i) {
+            const u64 e = segments[commits[i]].end;
+            const u64 s = i + 1 < commits.size() ? segments[commits[i + 1]].start : c0;
+            if (e && s > e && ns >= e + (s - e) / 2) idle += s - e;
+        }
+        return idle;
+    }
+
+    template <typename Convert>
+    u64 ReportTicks(size_t segment, bool top, Stamp stamp, u64 c0, u64 c1,
+                    u64 fallback, Convert convert) {
+        u64 ns = stamp.epoch == epoch ? stamp.ns : 0;
+        if (ns && begin > ns && begin - ns > 500000) ns = 0;
+        if (!ns && segment < segments.size())
+            ns = top ? segments[segment].start : segments[segment].end;
+        if (!ns) ns = top ? c0 : c1;
+        if (ns) {
+            const u64 idle = IdleBefore(ns, c0);
+            if (idle < ns) ns -= idle;
+        }
+        const u64 ticks = ns ? convert(ns) : fallback;
+        published = std::max(published, ticks);
+        return published;
+    }
+
+    // Modular subtraction before scaling: valid-bit wrap must not become a huge duration.
+    // More than half a counter cycle is ambiguous and falls back rather than guessing.
+    static u64 DeltaNs(u64 ticks, u64 origin, u32 bits, double period) {
+        if (!bits || bits > 64 || period <= 0) return 0;
+        const u64 mask = bits == 64 ? ~u64{0} : (u64{1} << bits) - 1;
+        const u64 delta = (ticks - origin) & mask;
+        if (delta > (mask >> 1)) return 0;
+        const double ns = double(delta) * period;
+        return ns < double(~u64{0}) ? static_cast<u64>(ns) : 0;
+    }
+};
+
+using TimestampConvert = std::function<u64(u64)>;
+using ReportTimestamp = std::function<u64(u64, const TimestampConvert&)>;
+
+template <typename Runtime, typename GPU>
+ReportTimestamp CaptureReportTimestamp(Runtime& runtime, GPU& gpu, bool enabled) {
+    if constexpr (requires { runtime.CaptureTimestamp(gpu.GetTimestampNs()); }) {
+        if (enabled) return runtime.CaptureTimestamp(gpu.GetTimestampNs());
+    }
+    return {};
+}
+
+template <typename GPU>
+u64 PublishReportTimestamp(const ReportTimestamp& ticket, GPU& gpu) {
+    const u64 fallback = gpu.GetTicks();
+    return ticket ? ticket(fallback, [&](u64 ns) { return gpu.TimestampFromNs(ns); }) : fallback;
+}
+
