+#ifdef EDEN_NX2_PS5_PROTO
+void BufferCacheRuntime::SubmitLongCopyRuns(size_t regions) {
+    static const size_t limit = [] {
+        const char* value = std::getenv("EDEN_NX2_COPIES_PER_SUBMISSION");
+        size_t parsed{};
+        if (value) {
+            const char* end = value + std::strlen(value);
+            const auto result = std::from_chars(value, end, parsed);
+            if (result.ec == std::errc{} && result.ptr == end && parsed > 0) {
+                return parsed;
+            }
+        }
+        return COPIES_PER_SUBMISSION;
+    }();
+    if (scheduler.CurrentTick() != copy_submission_tick) {
+        copy_submission_tick = scheduler.CurrentTick();
+        copy_submission_count = 0;
+    }
+    copy_submission_count += 1 + regions;
+    if (copy_submission_count >= limit) {
+        scheduler.Flush();
+        copy_submission_tick = scheduler.CurrentTick();
+        copy_submission_count = 0;
+    }
+}
+#endif
 
