diff --git a/src/core/file_sys/vfs/read_cache_budget.h b/src/core/file_sys/vfs/read_cache_budget.h
new file mode 100644
--- /dev/null
+++ b/src/core/file_sys/vfs/read_cache_budget.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <limits>
+#include <memory>
+#include <type_traits>
+#include <vector>
+
+namespace FileSys::ReadCacheMemory {
+inline constexpr std::size_t Limit = 64 * 1024 * 1024;
+inline std::atomic<std::size_t> live{}, peak{}, bypass{};
+struct BudgetExceeded {};
+inline void Reserve(std::size_t bytes) {
+    auto current = live.load(std::memory_order_relaxed);
+    do {
+        if (bytes > Limit - current) throw BudgetExceeded{};
+    } while (!live.compare_exchange_weak(current, current + bytes, std::memory_order_relaxed));
+    auto previous = peak.load(std::memory_order_relaxed);
+    while (previous < current + bytes &&
+           !peak.compare_exchange_weak(previous, current + bytes, std::memory_order_relaxed)) {}
+}
+// Allocation owns its reservation, independently of the VFS eviction policy.
+// std::vector returns it on destruction, clear+shrink, move replacement and unwind.
+template<class T> struct Allocator {
+    using value_type = T;
+    using is_always_equal = std::true_type;
+    using propagate_on_container_move_assignment = std::true_type;
+    Allocator() = default;
+    template<class U> Allocator(const Allocator<U>&) noexcept {}
+    [[nodiscard]] T* allocate(std::size_t count) {
+        if (count > (std::numeric_limits<std::size_t>::max)() / sizeof(T)) throw BudgetExceeded{};
+        const auto bytes = count * sizeof(T);
+        Reserve(bytes);
+        try { return std::allocator<T>{}.allocate(count); }
+        catch (...) { live.fetch_sub(bytes, std::memory_order_relaxed); throw; }
+    }
+    void deallocate(T* pointer, std::size_t count) noexcept {
+        std::allocator<T>{}.deallocate(pointer, count);
+        live.fetch_sub(count * sizeof(T), std::memory_order_relaxed);
+    }
+    template<class U> bool operator==(const Allocator<U>&) const noexcept { return true; }
+};
+template<class T> bool Prepare(std::vector<T, Allocator<T>>& data, std::size_t bytes) {
+    try { data.resize(bytes); return true; }
+    catch (const BudgetExceeded&) {
+        bypass.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+}
+} // namespace FileSys::ReadCacheMemory
