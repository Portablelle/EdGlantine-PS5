+        if (force_draw && draw_state.batch_bases) {
+            // The batch of a draw.begin First/Subsequent sequence: same bases as its first draw.
+            // OoT's text macros draw a line's glyphs as such a batch with the line's first glyph as
+            // base instance, then reset the register before DrawDeferred runs; with the register
+            // read here, every line drew the glyphs of the start of the buffer instead of its own.
+            draw_state.base_instance = draw_state.batch_base_instance;
+            draw_state.base_index = draw_state.batch_base_index;
+        } else {
+            draw_state.base_instance = maxwell3d.regs.global_base_instance_index;
+            draw_state.base_index = maxwell3d.regs.global_base_vertex_index;
+        }
+        if (!force_draw) {
