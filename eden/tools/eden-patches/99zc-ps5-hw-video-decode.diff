+
+bool IsRandomAccessPacket(Tegra::Host1x::NvdecCommon::VideoCodec codec,
+                          std::span<const u8> packet) {
+    using Tegra::Host1x::NvdecCommon::VideoCodec;
+    if (codec == VideoCodec::VP9) {
+        // Composed VP9 profile 0 header: marker 10, profile 00, show_existing 0, frame_type 0.
+        return !packet.empty() && (packet[0] & 0xfc) == 0x80;
+    }
+    if (codec == VideoCodec::H264) {
+        // Annex B, including both three- and four-byte start codes. Require an IDR NAL.
+        for (size_t i = 0; i + 3 < packet.size(); ++i) {
+            if (packet[i] == 0 && packet[i + 1] == 0 && packet[i + 2] == 1 &&
+                (packet[i + 3] & 0x1f) == 5) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+bool IsBackendFrameValid(const Frame& frame, const FrameDimensions& dimensions) {
+    const auto* av = frame.GetFrame();
+    if (frame.IsHardwareDecoded() || frame.GetWidth() != dimensions.width ||
+        frame.GetHeight() != dimensions.height || av->crop_top || av->crop_bottom ||
+        av->crop_left || av->crop_right || !frame.GetPlane(0) || !frame.GetPlane(1) ||
+        frame.GetStride(0) < dimensions.width) {
+        return false;
+    }
+    const s32 chroma_width = dimensions.width / 2 + dimensions.width % 2;
+    if (frame.GetPixelFormat() == AV_PIX_FMT_NV12) {
+        return frame.GetStride(1) >= s64{2} * chroma_width;
+    }
+    return frame.GetPixelFormat() == AV_PIX_FMT_YUV420P && frame.GetPlane(2) &&
+           frame.GetStride(1) >= chroma_width && frame.GetStride(2) >= chroma_width;
+}
