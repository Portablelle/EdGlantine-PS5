+HardwareVideoDecoderSession::Route HardwareVideoDecoderSession::Decode(
+    Tegra::Host1x::NvdecCommon::VideoCodec codec, std::span<const u8> packet,
+    const FrameOffsets& offsets, std::optional<FrameDimensions> dimensions, s64 pts,
+    std::span<const u8> extradata, std::shared_ptr<Frame>& frame) {
+    using Tegra::Host1x::NvdecCommon::VideoCodec;
+    frame.reset();
+    if (!m_checked) {
+        m_checked = true;
+        const auto factory = hardware_video_decoder_factory.load();
+        if (factory && HardwareVideoDecoderEnabled() && !offsets.interlaced && dimensions &&
+            dimensions->width > 0 && dimensions->height > 0 && dimensions->profile >= 0 &&
+            (codec == VideoCodec::H264 || codec == VideoCodec::VP9)) {
+            auto backend = factory();
+            if (backend && backend->Supports(codec, *dimensions)) {
+                m_backend = std::move(backend);
+                m_dimensions = dimensions;
+                if (!m_backend->Open(codec, *dimensions, extradata)) {
+                    m_backend->ReportFallback("open-failed");
+                    Finish();
+                    // No hardware references have been consumed yet; FFmpeg can take this packet.
+                    m_wait_for_keyframe = false;
+                }
+            }
+        }
+    }
+    if (m_backend) {
+        if (dimensions == m_dimensions && !offsets.interlaced &&
+            m_backend->Decode(packet, pts, frame) &&
+            (offsets.hidden || (frame && frame->GetFrame()->pts == pts &&
+                                IsBackendFrameValid(*frame, *dimensions)))) {
+            return Route::Hardware;
+        }
+        frame.reset();
+        m_backend->ReportFallback("decode-or-output-failed");
+        Finish();
+    }
+    if (m_wait_for_keyframe) {
+        if (!IsRandomAccessPacket(codec, packet)) {
+            return Route::Skipped;
+        }
+        m_wait_for_keyframe = false;
+    }
+    return Route::Software;
