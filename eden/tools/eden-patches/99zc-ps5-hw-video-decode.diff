+};
+
+// Optional frontend backend. Decode is synchronous, in decode order, and must consume hidden
+// packets too. A visible packet must return one CPU-readable NV12/YUV420P frame. AVBufferRefs
+// must own its planes independently of the decoder (including after Close). Dimensions are
+// the displayed dimensions; apply native output crop before returning the frame. Decode must
+// propagate pts and signal colorspace/color_range on the AVFrame. Native-video consumes 8-bit
+// planar 4:2:0 plus that metadata (NV12 is deinterleaved). Delayed/reordered output is not
+// supported by this synchronous contract: return failure rather than attach a wrong pts.
+// Open receives codec-specific extradata; the session supplies cached Annex-B SPS/PPS for AVC.
+class HardwareVideoDecoder {
+public:
+    virtual ~HardwareVideoDecoder() = default;
+    virtual bool Supports(Tegra::Host1x::NvdecCommon::VideoCodec codec,
+                          const FrameDimensions& dimensions) const = 0;
+    virtual bool Open(Tegra::Host1x::NvdecCommon::VideoCodec codec,
+                      const FrameDimensions& dimensions, std::span<const u8> extradata = {}) = 0;
+    virtual bool Decode(std::span<const u8> packet, s64 pts, std::shared_ptr<Frame>& frame) = 0;
+    virtual void Close() = 0;
+    // The default logs once at the selection seam; native backends can retain a specific reason.
+    virtual void ReportFallback(const char* reason);
+};
+
+using HardwareVideoDecoderFactory = std::unique_ptr<HardwareVideoDecoder> (*)();
+// Register before starting decoder threads. Null by default; existing backends are unaffected.
+void RegisterHardwareVideoDecoder(HardwareVideoDecoderFactory factory);
+
+bool HardwareVideoDecoderAvailable();
+
+// Selection and H.264 recovery adapter shared by host1x and INativeVideoCodec. Software means
+// submit this packet to FFmpeg; Skipped consumes it while waiting for a reference-safe restart.
+class HardwareVideoDecoderSession {
+public:
+    HardwareVideoDecoderSession(const HardwareVideoDecoderSession&) = delete;
+    HardwareVideoDecoderSession& operator=(const HardwareVideoDecoderSession&) = delete;
+    HardwareVideoDecoderSession() = default;
+    ~HardwareVideoDecoderSession();
+    enum class Route { Software, Hardware, Skipped };
+    Route Decode(Tegra::Host1x::NvdecCommon::VideoCodec codec, std::span<const u8> packet,
+                 const FrameOffsets& offsets, std::optional<FrameDimensions> dimensions, s64 pts,
+                 std::span<const u8> extradata, std::shared_ptr<Frame>& frame);
+    void Reset();
+    // Synchronous backends have no queued output. Drain closes them and subsequent packets
+    // use FFmpeg from the next IDR/keyframe; it does not retry hardware after EOS/Flush/Stop.
+    void Finish();
+    // Fallback is software after a hardware attempt; Software was never admitted to hardware.
+    enum class State { Selection, Hardware, Recovery, Software, Fallback };
+    State GetState() const { return m_state; }
+    bool IsActive() const { return m_state == State::Hardware; }
+    bool IsWaiting() const { return m_state == State::Recovery; }
+    bool HasFallenBack() const { return m_state == State::Recovery || m_state == State::Fallback; }
+    std::vector<u8> TakeRestartPacket() { return std::exchange(m_restart_packet, {}); }
+    bool SoftwareResult(bool accepted);
+    void ConfigureH264(std::span<const u8> extradata);
+
+private:
+    std::unique_ptr<HardwareVideoDecoder> m_backend;
+    FrameDimensions m_dimensions{};
+    Eden::VideoDecode::H264ParameterSets m_h264;
+    std::vector<u8> m_restart_packet;
+    void Transition(State next);
+    State m_state{State::Selection};
+};
+
+} // namespace FFmpeg
