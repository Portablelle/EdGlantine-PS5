+// SPDX-License-Identifier: GPL-3.0-only
+#include "video_core/host1x/hardware_video_decoder.h"
+#include <atomic>
+#include <cstdlib>
+#include <string_view>
+
+namespace FFmpeg {
+namespace {
+std::atomic<HardwareVideoDecoderFactory> hardware_video_decoder_factory{};
+bool Enabled() {
+    const char* value = std::getenv("EDEN_PS5_HW_VIDEODEC");
+    return !value || std::string_view{value} != "0";
+}
+bool IsRandomAccess(Tegra::Host1x::NvdecCommon::VideoCodec codec, std::span<const u8> packet) {
+    using Tegra::Host1x::NvdecCommon::VideoCodec;
+    return codec == VideoCodec::H264 ? Eden::VideoDecode::IsIdr(packet) :
+           codec == VideoCodec::VP9 && !packet.empty() && (packet[0] & 0xfc) == 0x80;
+}
+}
+
+void RegisterHardwareVideoDecoder(HardwareVideoDecoderFactory factory) {
+    hardware_video_decoder_factory.store(factory);
+}
+bool HardwareVideoDecoderAvailable() {
+    return hardware_video_decoder_factory.load() && Enabled();
+}
+HardwareVideoDecoderSession::~HardwareVideoDecoderSession() { Reset(); }
+
+void HardwareVideoDecoderSession::Transition(State next) {
+    if (m_state == State::Hardware && next != State::Hardware) {
+        m_backend->Close();
+        m_backend.reset();
+        m_dimensions = {};
+    }
+    m_state = next;
+}
+void HardwareVideoDecoderSession::Reset() {
+    Transition(State::Selection);
+    m_h264 = {};
+    m_restart_packet.clear();
+}
+void HardwareVideoDecoderSession::Finish() {
+    if (m_state == State::Hardware) Transition(State::Recovery);
+}
+void HardwareVideoDecoderSession::ConfigureH264(std::span<const u8> extradata) {
+    if (HardwareVideoDecoderAvailable() || IsWaiting()) {
+        if (const auto extra = Eden::VideoDecode::H264Extradata(extradata)) m_h264.Observe(*extra);
+    }
+}
+bool HardwareVideoDecoderSession::SoftwareResult(bool accepted) {
+    if (!accepted && HasFallenBack()) Transition(State::Recovery);
+    return accepted || HasFallenBack();
+}
+
+HardwareVideoDecoderSession::Route HardwareVideoDecoderSession::Decode(
+    Tegra::Host1x::NvdecCommon::VideoCodec codec, std::span<const u8> packet,
+    const FrameOffsets& offsets, std::optional<FrameDimensions> dimensions, s64 pts,
+    std::span<const u8> extradata, std::shared_ptr<Frame>& frame) {
+    using Tegra::Host1x::NvdecCommon::VideoCodec;
+    frame.reset();
+    m_restart_packet.clear();
+    if (codec == VideoCodec::H264 &&
+        ((m_state == State::Selection && HardwareVideoDecoderAvailable()) || IsActive() || IsWaiting())) {
+        if (m_state == State::Selection) ConfigureH264(extradata);
+        m_h264.Observe(packet);
+        if (dimensions && dimensions->profile < 0) dimensions->profile = m_h264.profile;
+    }
+    if (m_state == State::Selection) {
+        const auto factory = hardware_video_decoder_factory.load();
+        if (factory && Enabled() && !offsets.interlaced && dimensions &&
+            dimensions->width > 0 && dimensions->height > 0 && dimensions->profile >= 0 &&
+            (codec == VideoCodec::H264 || codec == VideoCodec::VP9)) {
+            auto backend = factory();
+            if (backend && backend->Supports(codec, *dimensions)) {
+                // Include in-band SPS before Open so admission can verify its VUI restrictions.
+                const auto parameters = codec == VideoCodec::H264 ? m_h264.Restore({}) : std::vector<u8>{};
+                if (!backend->Open(codec, *dimensions,
+                                   codec == VideoCodec::H264 ? std::span<const u8>{parameters} : extradata)) {
+                    backend->ReportFallback("open-failed");
+                    backend->Close();
+                    Transition(State::Fallback); // No references consumed: submit current packet.
+                    if (codec == VideoCodec::H264) m_restart_packet = m_h264.Restore(packet);
+                } else {
+                    m_backend = std::move(backend);
+                    m_dimensions = *dimensions;
+                    Transition(State::Hardware);
+                }
+            }
+        }
+        if (m_state == State::Selection) Transition(State::Software);
+    }
+    if (m_state == State::Hardware) {
+        if (dimensions == m_dimensions && !offsets.interlaced &&
+            m_backend->Decode(packet, pts, frame) &&
+            (offsets.hidden || (frame && IsBackendFrameValid(*frame, *dimensions, pts)))) {
+            return Route::Hardware;
+        }
+        frame.reset();
+        m_backend->ReportFallback("decode-or-output-failed");
+        Transition(State::Recovery);
+    }
+    if (m_state == State::Recovery) {
+        if (!IsRandomAccess(codec, packet)) return Route::Skipped;
+        if (codec == VideoCodec::H264) m_restart_packet = m_h264.Restore(packet);
+        Transition(State::Fallback);
+    }
+    return Route::Software;
+}
+} // namespace FFmpeg
