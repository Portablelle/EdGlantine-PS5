+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from sainsaji/EVO-PLAYER-PS5 a54dcf516e9cfda4c26d78733bf5ccb8c10e7e0b (GPL-3.0)
+// Shared, bounded packet framing for backend validation and software recovery.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace Eden::VideoDecode {
+using Bytes = std::span<const std::uint8_t>;
+constexpr std::size_t InputBytes = 0x800000;
+
+inline std::vector<Bytes> AnnexBNals(Bytes bytes) {
+    std::vector<Bytes> units;
+    std::size_t begin = 0;
+    bool found = false;
+    for (std::size_t i = 0; i + 3 <= bytes.size(); ++i) {
+        if (bytes[i] || bytes[i + 1] || bytes[i + 2] != 1) continue;
+        if (found) {
+            auto end = i;
+            while (end > begin && bytes[end - 1] == 0) --end;
+            if (end == begin) return {};
+            units.push_back(bytes.subspan(begin, end - begin));
+        } else {
+            for (std::size_t j = 0; j < i; ++j) if (bytes[j]) return {};
+        }
+        found = true;
+        begin = i + 3;
+        i += 2;
+    }
+    if (!found || begin == bytes.size()) return {};
+    auto end = bytes.size();
+    while (end > begin && bytes[end - 1] == 0) --end;
+    if (end == begin) return {};
+    units.push_back(bytes.subspan(begin, end - begin));
+    for (const auto unit : units) {
+        const auto type = unit[0] & 31;
+        if ((unit[0] & 0x80) || !type || type > 23 || (type <= 9 && unit.size() < 2)) return {};
+    }
+    return units;
+}
+
+inline bool IsIdr(Bytes bytes) {
+    for (auto nal : AnnexBNals(bytes)) if ((nal[0] & 31) == 5) return true;
+    return false;
+}
+
+// Native Configure may supply avcC; the decoder itself only receives Annex-B access units.
+inline std::optional<std::vector<std::uint8_t>> H264Extradata(Bytes bytes) {
+    if (bytes.size() > InputBytes) return {};
+    if (bytes.empty()) return std::vector<std::uint8_t>{};
+    if (!AnnexBNals(bytes).empty()) return std::vector<std::uint8_t>{bytes.begin(), bytes.end()};
+    if (bytes.size() < 7 || bytes[0] != 1) return {};
+    std::vector<std::uint8_t> result;
+    std::size_t pos = 6;
+    unsigned count = bytes[5] & 31;
+    for (int group = 0; group < 2; ++group) {
+        for (unsigned i = 0; i < count; ++i) {
+            if (bytes.size() - pos < 2) return {};
+            const auto length = (std::size_t{bytes[pos]} << 8) | bytes[pos + 1];
+            pos += 2;
+            if (!length || length > bytes.size() - pos || result.size() + length + 4 > InputBytes) return {};
+            result.insert(result.end(), {0, 0, 0, 1});
+            result.insert(result.end(), bytes.begin() + pos, bytes.begin() + pos + length);
+            pos += length;
+        }
+        if (group == 0) {
+            if (pos == bytes.size()) return {};
+            count = bytes[pos++];
+        }
+    }
+    return result;
+}
+
+struct Bits {
+    Bytes bytes;
+    std::size_t pos{};
+    bool valid{true};
+    std::uint32_t Read(unsigned count) {
+        if (count > 32 || pos > bytes.size() * 8 || count > bytes.size() * 8 - pos) {
+            valid = false;
+            return 0;
+        }
+        std::uint32_t value = 0;
+        while (count--) { value = (value << 1) | ((bytes[pos / 8] >> (7 - pos % 8)) & 1); ++pos; }
+        return value;
+    }
+    std::uint32_t UE() {
+        unsigned zeros = 0;
+        while (valid && Read(1) == 0) if (++zeros > 30) { valid = false; return 0; }
+        return ((1U << zeros) - 1) + Read(zeros);
+    }
+    std::int32_t SE() {
+        const auto value = UE();
+        return value & 1 ? static_cast<std::int32_t>((value + 1) / 2) : -static_cast<std::int32_t>(value / 2);
+    }
+};
+inline std::vector<std::uint8_t> Rbsp(Bytes nal, std::size_t limit = InputBytes) {
+    std::vector<std::uint8_t> result;
+    unsigned zeros = 0;
+    for (std::size_t i = 1; i < nal.size() && result.size() < limit; ++i) {
+        if (zeros >= 2 && nal[i] == 3) {
+            if (i + 1 == nal.size() || nal[i + 1] > 3) return {};
+            zeros = 0;
+            continue;
+        }
+        result.push_back(nal[i]);
+        zeros = nal[i] == 0 ? zeros + 1 : 0;
+    }
+    return result;
+}
+// H.264 E.1.2 HRD syntax; cpb_cnt_minus1 is bounded to 31 by the specification.
+inline bool H264Hrd(Bits& b) {
+    const auto count = b.UE();
+    if (!b.valid || count > 31) return false;
+    b.Read(4); b.Read(4);
+    for (unsigned i = 0; i <= count; ++i) { b.UE(); b.UE(); b.Read(1); }
+    b.Read(5); b.Read(5); b.Read(5); b.Read(5);
+    return b.valid;
+}
+
+struct Picture {
+    std::uint32_t coded_width{}, coded_height{}, width{}, height{}, left{}, top{}, level{};
+    std::uint32_t matrix{2}; // AVCOL_SPC_UNSPECIFIED, native service keeps its BT.709 default.
+    bool full_range{}, no_reordering{};
+};
+inline std::optional<Picture> H264Sps(Bytes nal) {
+    auto data = Rbsp(nal);
+    Bits b{data};
+    const auto profile = b.Read(8);
+    b.Read(8); const auto level = b.Read(8);
+    if (b.UE() > 31) return {}; // constraints, level, SPS id
+    if (!level || level > 52) return {};
+    if (profile == 100) {
+        if (b.UE() != 1 || b.UE() != 0 || b.UE() != 0) return {}; // 8-bit 4:2:0 only
+        b.Read(1);
+        if (b.Read(1)) {
+            for (int list = 0; list < 8; ++list) {
+                if (!b.Read(1)) continue;
+                int last = 8, next = 8;
+                for (int i = 0; i < (list < 6 ? 16 : 64); ++i) {
+                    if (next) next = static_cast<int>((std::int64_t{last} + b.SE() + 256) & 255);
+                    last = next ? next : last;
+                }
+            }
+        }
+    } else if (profile != 66 && profile != 77) return {};
+    if (b.UE() > 12) return {};
+    const auto poc = b.UE();
+    if (poc == 0) { if (b.UE() > 12) return {}; }
+    else if (poc == 1) {
+        b.Read(1); b.SE(); b.SE();
+        const auto cycle = b.UE();
+        if (cycle > 256) return {};
+        for (unsigned i = 0; i < cycle; ++i) b.SE();
+    } else if (poc != 2) return {};
+    const auto references = b.UE();
+    if (references > 4) return {}; // The documented depth-one decoder has four DPB frames.
+    b.Read(1);
+    const auto mw = b.UE(), mh = b.UE();
+    if (mw >= 240 || mh >= 136 || !b.Read(1)) return {}; // progressive only
+    b.Read(1);
+    Picture p;
+    p.level = level;
+    p.coded_width = (mw + 1) * 16; p.coded_height = (mh + 1) * 16;
+    std::uint32_t right = 0, bottom = 0;
+    if (b.Read(1)) { p.left = b.UE(); right = b.UE(); p.top = b.UE(); bottom = b.UE(); }
+    if (p.left >= p.coded_width / 2 || right >= p.coded_width / 2 - p.left ||
+        p.top >= p.coded_height / 2 || bottom >= p.coded_height / 2 - p.top) return {};
+    p.left *= 2; p.top *= 2;
+    p.width = p.coded_width - p.left - right * 2;
+    p.height = p.coded_height - p.top - bottom * 2;
+    if (b.Read(1)) { // vui_parameters_present_flag
+        if (b.Read(1) && b.Read(8) == 255) { b.Read(16); b.Read(16); }
+        if (b.Read(1)) b.Read(1);
+        if (b.Read(1)) {
+            b.Read(3); p.full_range = b.Read(1);
+            if (b.Read(1)) { b.Read(8); b.Read(8); p.matrix = b.Read(8); }
+        }
+        if (b.Read(1)) { // chroma_loc_info_present_flag
+            if (b.UE() > 5 || b.UE() > 5) return {};
+        }
+        if (b.Read(1)) { // timing_info_present_flag
+            if (!b.Read(32) || !b.Read(32)) return {};
+            b.Read(1);
+        }
+        const bool nal_hrd = b.Read(1);
+        if (nal_hrd && !H264Hrd(b)) return {};
+        const bool vcl_hrd = b.Read(1);
+        if (vcl_hrd && !H264Hrd(b)) return {};
+        if (nal_hrd || vcl_hrd) b.Read(1); // low_delay_hrd_flag
+        b.Read(1); // pic_struct_present_flag
+        if (b.Read(1)) { // bitstream_restriction_flag
+            b.Read(1); // motion_vectors_over_pic_boundaries_flag
+            for (int i = 0; i < 4; ++i) if (b.UE() > 16) return {};
+            const auto reorder = b.UE(), buffering = b.UE();
+            if (buffering < references || buffering > 4 || reorder > buffering) return {};
+            p.no_reordering = reorder == 0;
+        }
+    }
+    // Require the complete bounded syntax, including rbsp_trailing_bits. Absence of VUI or
+    // bitstream restrictions is valid SPS syntax but never proves decode-order output.
+    if (!b.Read(1)) return {};
+    while (b.valid && b.pos % 8) if (b.Read(1)) return {};
+    if (!b.valid || b.pos != data.size() * 8 || p.matrix > 14) return {};
+    return p;
+}
+
+template <class Frame>
+inline bool ValidFrame(const Frame& frame, int width, int height, std::int64_t pts, int nv12, int yuv420p) {
+    const auto* av = frame.GetFrame();
+    if (!av || av->pts != pts || frame.IsHardwareDecoded() || frame.GetWidth() != width ||
+        frame.GetHeight() != height || av->crop_top || av->crop_bottom ||
+        av->crop_left || av->crop_right || !frame.GetPlane(0) || !frame.GetPlane(1) ||
+        frame.GetStride(0) < width) {
+        return false;
+    }
+    const std::int32_t chroma_width = width / 2 + width % 2;
+    if (frame.GetPixelFormat() == nv12) {
+        return frame.GetStride(1) >= std::int64_t{2} * chroma_width;
+    }
+    return frame.GetPixelFormat() == yuv420p && frame.GetPlane(2) &&
+           frame.GetStride(1) >= chroma_width && frame.GetStride(2) >= chroma_width;
+}
+// Fixed ID spaces from H.264 7.4.2.1/7.4.2.2. No eviction of still-active IDs.
+struct H264ParameterSets {
+    std::array<std::vector<std::uint8_t>, 32> sps;
+    std::array<std::vector<std::uint8_t>, 256> pps;
+    int profile{-1};
+
+    void Observe(Bytes bytes) {
+        for (auto nal : AnnexBNals(bytes)) {
+            const auto type = nal[0] & 31;
+            if ((type != 7 && type != 8) || nal.size() > 65536) continue;
+            auto rbsp = Rbsp(nal);
+            Bits b{rbsp};
+            if (type == 7) b.Read(24); // profile_idc, constraints, level_idc
+            const auto id = b.UE();
+            const auto parent = type == 8 ? b.UE() : 0;
+            if (!b.valid || parent >= sps.size()) continue;
+            if (type == 7) {
+                if (id >= sps.size()) continue;
+                sps[id].assign(nal.begin(), nal.end());
+                profile = rbsp[0];
+            } else if (id < pps.size()) pps[id].assign(nal.begin(), nal.end());
+        }
+    }
+    std::vector<std::uint8_t> Restore(Bytes packet) const {
+        std::vector<std::uint8_t> result;
+        for (const auto& nal : sps) Append(result, nal); // SPS before every PPS.
+        for (const auto& nal : pps) Append(result, nal);
+        result.insert(result.end(), packet.begin(), packet.end());
+        return result;
+    }
+private:
+    static void Append(std::vector<std::uint8_t>& result, Bytes nal) {
+        if (nal.empty()) return;
+        result.insert(result.end(), {0, 0, 0, 1});
+        result.insert(result.end(), nal.begin(), nal.end());
+    }
+};
+} // namespace Eden::VideoDecode
