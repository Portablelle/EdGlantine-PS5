     }
 }
 
+void StagingBufferPool::LogHeld() const {
+    const auto report = [this](const char* kind, const StagingBuffersCache& cache) {
+        u64 held{}, idle{};
+        size_t buffers{};
+        for (const StagingBuffers& level : cache) {
+            for (const StagingBuffer& entry : level.entries) {
+                const u64 bytes = entry.mapped_span.size() != 0 ? entry.mapped_span.size()
+                                                                : u64{1} << entry.log2_level;
+                held += bytes;
+                ++buffers;
+                if (!entry.deferred && scheduler.IsFree(entry.tick)) idle += bytes;
+            }
+        }
+        LOG_INFO(Render_Vulkan, "Staging pool {}: {} buffers {} MiB, {} MiB idle", kind, buffers, held >> 20,
+                 idle >> 20);
+    };
+    report("upload", upload_cache);
+    report("download", download_cache);
+    report("device", device_local_cache);
+    LOG_INFO(Render_Vulkan, "Staging pool stream buffer: {} MiB", stream_buffer_size >> 20);
+}
+
 } // namespace Vulkan
