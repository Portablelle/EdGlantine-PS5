# Constant addresses remain in the read-only/executable view. Every store must
# use its writable alias, including the compact indexed pool from Eden #4516.
file(READ "${PROJECT_SOURCE_DIR}/src/dynarmic/src/dynarmic/backend/x64/constant_pool.cpp" pool_source)
set(compact_pool_store "    if (inserted) pool[it->second] = u128{lower, upper};")
set(legacy_pool_store "        target_constant = constant;")
string(FIND "${pool_source}" "${compact_pool_store}" compact_pool_at)
string(FIND "${pool_source}" "${legacy_pool_store}" legacy_pool_at)
if(compact_pool_at GREATER_EQUAL 0 AND legacy_pool_at LESS 0)
    set(pool_store "${compact_pool_store}")
    set(alias_pool_store "    if (inserted) *reinterpret_cast<u128*>(code.writableAddress(&pool[it->second])) = u128{lower, upper};")
elseif(legacy_pool_at GREATER_EQUAL 0 AND compact_pool_at LESS 0)
    set(pool_store "${legacy_pool_store}")
    set(alias_pool_store "        *reinterpret_cast<ConstantT*>(code.writableAddress(&target_constant)) = constant;")
else()
    message(FATAL_ERROR "Unrecognized JIT constant-pool store; writable alias adaptation required")
endif()
string(REPLACE "${pool_store}" "" pool_without_store "${pool_source}")
string(LENGTH "${pool_source}" pool_source_length)
string(LENGTH "${pool_without_store}" pool_without_store_length)
string(LENGTH "${pool_store}" pool_store_length)
math(EXPR pool_store_count "(${pool_source_length} - ${pool_without_store_length}) / ${pool_store_length}")
if(NOT pool_store_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one JIT constant-pool store, found ${pool_store_count}")
endif()
string(REPLACE "${pool_store}" "${alias_pool_store}" pool_source "${pool_source}")
write_derived("${PORT_BUILD_DIR}/constant_pool.cpp" "${pool_source}")
